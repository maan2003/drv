package drv:hardware@0.1.0;

interface broker {
    enum error {
        invalid,
        stale-handle,
        out-of-bounds,
        limit,
        cancelled,
        device-fault,
    }

    enum dma-access {
        device-read,
        device-write,
        bidirectional,
    }

    record irq-event {
        vector: u32,
        count: u64,
        at-ns: u64,
    }

    resource region {
        read-u32: func(offset: u32) -> result<u32, error>;
        write-u32: func(offset: u32, value: u32) -> result<_, error>;
    }

    resource dma-arena {
        length: func() -> result<u32, error>;
        iova: func() -> result<u64, error>;
        read: func(offset: u32, length: u32) -> result<list<u8>, error>;
        write: func(offset: u32, bytes: list<u8>) -> result<_, error>;
    }

    resource interrupt {
        wait-until: func(deadline-ns: u64) -> result<option<irq-event>, error>;
    }

    resource device {
        generation: func() -> u64;
        open-region: func(index: u8) -> result<region, error>;
        alloc-dma: func(size: u32, alignment: u32, access: dma-access)
            -> result<dma-arena, error>;
        open-interrupt: func(vector: u32) -> result<interrupt, error>;
        reset: func() -> result<u64, error>;
    }

    get-device: func() -> device;
    now: func() -> u64;
}

interface probe {
    use broker.{error};

    record report {
        generation-before: u64,
        generation-after: u64,
        iova: u64,
        interrupt-count: u64,
        interrupt-at-ns: u64,
        dma-round-trip: bool,
        device-dma-observed: bool,
        bounds-rejected: bool,
        bar-bounds-rejected: bool,
        stale-rejected: bool,
        region-stale-rejected: bool,
    }

    run: func() -> result<report, error>;
}

world driver {
    import broker;
    export probe;
}
