#!/usr/bin/env bash
set -euo pipefail
device=${REDWOOD_WIFI_DEVICE:-17a10040.wifi}
driver_dir=${REDWOOD_DRIVER_DIR:-/sys/bus/platform/drivers/ath11k}
report_dir=${REDWOOD_REPORT_DIR:-/var/lib/ath11k-redwood-lab}
systemctl_cmd=${REDWOOD_SYSTEMCTL:-systemctl}
ip_cmd=${REDWOOD_IP:-ip}
deadline=${REDWOOD_DEADLINE_SECONDS:-120}
restore() {
  mkdir -p "$report_dir"
  { date -Ins; echo "RESTORE_BEGIN device=$device"; } >>"$report_dir/restore.log"
  if [[ ! -e "$driver_dir/$device" ]]; then printf '%s' "$device" >"$driver_dir/bind"; fi
  "$systemctl_cmd" restart iwd
  for _ in $(seq 1 60); do
    if "$ip_cmd" -4 -o address show dev wlan0 scope global | grep -q .; then
      echo "RESTORE_OK" >>"$report_dir/restore.log"; return 0
    fi
    sleep 1
  done
  echo "RESTORE_FAILED" >>"$report_dir/restore.log"; return 1
}
case ${1-} in
 --restore) restore; exit;;
 --self-test)
   t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
   mkdir -p "$t/driver" "$t/report" "$t/bin"
   : >"$t/driver/bind"
   cat >"$t/bin/systemctl" <<'SH'
#!/bin/sh
echo "$*" >>"$REDWOOD_TEST_LOG"
SH
   cat >"$t/bin/ip" <<'SH'
#!/bin/sh
echo '1: wlan0 inet 192.0.2.2/24 scope global wlan0'
SH
   chmod +x "$t/bin/"*
   REDWOOD_WIFI_DEVICE=test.wifi REDWOOD_DRIVER_DIR="$t/driver" \
    REDWOOD_REPORT_DIR="$t/report" REDWOOD_SYSTEMCTL="$t/bin/systemctl" \
    REDWOOD_IP="$t/bin/ip" REDWOOD_TEST_LOG="$t/actions" "$0" --restore
   grep -qx test.wifi "$t/driver/bind"
   grep -qx 'restart iwd' "$t/actions"
   grep -qx RESTORE_OK "$t/report/restore.log"
   echo SELF_TEST_RESTORE_OK
   exit;;
 --plan)
   echo "PLAN device=$device deadline_seconds=$deadline local_systemd_restore=true durable_report=$report_dir"
   exit;;
 --run) shift;;
 *) echo "usage: $0 --plan|--self-test|--restore|--run COMMAND..." >&2; exit 2;;
esac
[[ $EUID -eq 0 ]] || { echo root-required >&2; exit 1; }
[[ $# -gt 0 ]] || { echo missing-command >&2; exit 2; }
mkdir -p "$report_dir"
unit=ath11k-redwood-restore
systemd-run --quiet --unit="$unit" --on-active="${deadline}s" \
  "$(readlink -f "$0")" --restore
cleanup() {
  rc=$?
  restore || true
  systemctl stop "${unit}.timer" >/dev/null 2>&1 || true
  exit "$rc"
}
trap cleanup EXIT HUP INT TERM
timeout --signal=TERM --kill-after=10 "${deadline}s" "$@"
