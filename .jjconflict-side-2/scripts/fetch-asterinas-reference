#!/usr/bin/env bash
set -euo pipefail

commit=2e2b3468f07815be2c372fd5cd103bb37664ad5c
archive="reference/asterinas-$commit.tar.gz"
root="reference/asterinas-$commit"

mkdir -p reference

if [[ ! -f "$archive" ]]; then
  curl -fL --retry 3 \
    "https://github.com/asterinas/asterinas/archive/$commit.tar.gz" \
    -o "$archive"
fi

sha256sum "$archive" >"$archive.sha256"
rm -rf "$root"
mkdir -p "$root"
tar -xzf "$archive" -C "$root" --strip-components=1
printf '%s\n' "$commit" >"$root/COMMIT"
