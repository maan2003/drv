#!/usr/bin/env bash
set -euo pipefail
out=${1:?usage: capture-native-ath11k OUTDIR COMMAND...}
shift
trace=/sys/kernel/tracing
mkdir -p "$out"/{wmi,htt,qmi,hal}
zgrep '^CONFIG_ATH11K_TRACING=y$' /proc/config.gz >"$out/kernel-config.txt" || {
  echo 'BLOCKED: running kernel lacks CONFIG_ATH11K_TRACING=y' | tee "$out/BLOCKED"
  exit 1
}
for e in ath11k_wmi_cmd ath11k_wmi_event ath11k_htt_pktlog ath11k_htt_ppdu_stats ath11k_htt_rxdesc; do
 test -e "$trace/events/ath11k/$e/enable" || { echo "missing $e" | tee "$out/BLOCKED"; exit 1; }
done
command -v trace-cmd >/dev/null || { echo 'BLOCKED: trace-cmd is absent' | tee "$out/BLOCKED"; exit 1; }
# trace.dat preserves dynamic arrays that trace_pipe's TP_printk omits.
trace-cmd record -o "$out/native-trace.dat" \
 -e ath11k:ath11k_wmi_cmd -e ath11k:ath11k_wmi_event \
 -e ath11k:ath11k_htt_pktlog -e ath11k:ath11k_htt_ppdu_stats \
 -e ath11k:ath11k_htt_rxdesc -- "$@"
trace-cmd report -R "$out/native-trace.dat" >"$out/ordered.txt"
cp "$out/ordered.txt" "$out/wmi/ordered.txt"
cp "$out/ordered.txt" "$out/htt/ordered.txt"
printf '%s\n' 'QMI payload bytes are not exposed by ath11k tracepoints; capture requires an added tracepoint or socket instrumentation.' >"$out/qmi/NOT-OBSERVABLE"
printf '%s\n' 'TX/TCL/REO/WBM raw descriptor contents are not exposed. htt_rxdesc covers selected RX log modes only.' >"$out/hal/NOT-OBSERVABLE"
