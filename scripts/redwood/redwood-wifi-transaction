#!/bin/sh
set -eu
PATH=/run/current-system/sw/bin:/bin:/sbin
export PATH

report_dir=${REDWOOD_REPORT_DIR:-/var/lib/ath11k-redwood-lab}
systemd_run=${REDWOOD_SYSTEMD_RUN:-systemd-run}
inhibit_cmd=${REDWOOD_SYSTEMD_INHIBIT:-systemd-inhibit}
timeout_cmd=${REDWOOD_TIMEOUT:-timeout}
sysrq_trigger=${REDWOOD_SYSRQ_TRIGGER:-/proc/sysrq-trigger}
reboot_cmd=${REDWOOD_REBOOT:-reboot}
deadline=${REDWOOD_DEADLINE_SECONDS:-120}

recover() {
  reason=${1:-unspecified}
  mkdir -p "$report_dir"
  { date -Ins; echo "RECOVERY_BEGIN reason=$reason action=forced_reboot"; } \
    >>"$report_dir/recovery.log"
  sync
  if ! printf b >"$sysrq_trigger"; then
    "$reboot_cmd" -f
  fi
}

case ${1-} in
  --recover)
    recover "${2:-deadline}"
    exit
    ;;
  --self-test)
    t=$(mktemp -d)
    trap 'rm -rf "$t"' EXIT
    mkdir -p "$t/bin" "$t/report"
    : >"$t/sysrq-trigger"
    cat >"$t/bin/systemd-run" <<'SH'
#!/bin/sh
printf '%s\n' "$*" >>"$REDWOOD_TEST_ACTIONS"
SH
    cat >"$t/bin/systemd-inhibit" <<'SH'
#!/bin/sh
while [ "$#" -gt 0 ]; do
  case $1 in --what=*|--mode=*|--why=*) shift;; *) break;; esac
done
exec "$@"
SH
    chmod +x "$t/bin/"*
    REDWOOD_REPORT_DIR="$t/report" REDWOOD_SYSTEMD_RUN="$t/bin/systemd-run" \
      REDWOOD_SYSTEMD_INHIBIT="$t/bin/systemd-inhibit" REDWOOD_TIMEOUT=timeout \
    REDWOOD_SYSRQ_TRIGGER="$t/sysrq-trigger" REDWOOD_REBOOT=false \
      REDWOOD_DEADLINE_SECONDS=1 REDWOOD_TEST_ACTIONS="$t/actions" \
      REDWOOD_TEST_MODE=1 \
      "$0" --run sh -c 'sleep 10' || test "$?" -eq 124
    grep -q -- '--on-active=1s' "$t/actions"
    grep -q -- '--recover deadline' "$t/actions"
    grep -q 'RECOVERY_BEGIN reason=runner_exit_124 action=forced_reboot' \
      "$t/report/recovery.log"
    test "$(cat "$t/sysrq-trigger")" = b
    : >"$t/sysrq-trigger"
    REDWOOD_REPORT_DIR="$t/report" REDWOOD_SYSTEMD_RUN="$t/bin/systemd-run" \
      REDWOOD_SYSTEMD_INHIBIT="$t/bin/systemd-inhibit" REDWOOD_TIMEOUT=timeout \
      REDWOOD_SYSRQ_TRIGGER="$t/sysrq-trigger" REDWOOD_REBOOT=false \
      REDWOOD_DEADLINE_SECONDS=5 REDWOOD_TEST_ACTIONS="$t/actions" \
      REDWOOD_TEST_MODE=1 \
      "$0" --run true
    grep -q 'RECOVERY_BEGIN reason=runner_exit_0 action=forced_reboot' \
      "$t/report/recovery.log"
    test "$(cat "$t/sysrq-trigger")" = b
    echo SELF_TEST_RUNNER_RECOVERY_OK
    exit
    ;;
  --plan)
    echo "PLAN deadline_seconds=$deadline local_systemd_reboot=true sleep_inhibited=true durable_report=$report_dir"
    exit
    ;;
  --run)
    shift
    ;;
  *)
    echo "usage: $0 --plan|--self-test|--recover [REASON]|--run COMMAND..." >&2
    exit 2
    ;;
esac

if [ "$(id -u)" -ne 0 ] && [ "${REDWOOD_TEST_MODE:-}" != 1 ]; then
  echo root-required >&2
  exit 1
fi
[ "$#" -gt 0 ] || { echo missing-command >&2; exit 2; }
mkdir -p "$report_dir"
unit=ath11k-redwood-reboot
"$systemd_run" --quiet --unit="$unit" --on-active="${deadline}s" \
  "$(readlink -f "$0")" --recover deadline

set +e
"$inhibit_cmd" --what=sleep --mode=block --why="Redwood Wi-Fi lab transaction" \
  "$timeout_cmd" --signal=TERM --kill-after=10 "${deadline}s" "$@"
rc=$?
set -e

# No-reset VFIO ownership is recovered only by reboot. In particular, a
# successful runner must not disarm protection and continue in this kernel.
recover "runner_exit_$rc"
exit "$rc"
