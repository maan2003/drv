#!/bin/sh
# Operator-attended Redwood WPA3 association. SSH only submits the work: a
# phone-local transient unit owns the service through verified WPSS-offline
# teardown, independently of the submitting transport and log observers.
set -eu

PATH=/run/current-system/sw/bin:/bin:/sbin
export PATH

LAB=/var/lib/ath11k-redwood-lab
BIN=$LAB/stage13
NETWORK_SERVICE=${REDWOOD_NETWORK_SERVICE-$LAB/candidate/drv-network-service}
RUN=$LAB/runs/wpa3-ajay-channel149
SYSTEMD_RUN=${REDWOOD_SYSTEMD_RUN:-systemd-run}
SYSTEMCTL=${REDWOOD_SYSTEMCTL:-systemctl}
NC=${REDWOOD_NC:-nc}
UNIT=ath11k-redwood-wpa3-diagnostic
CREDENTIAL=/var/lib/iwd/ajay.psk
RPROC=/sys/class/remoteproc/remoteproc2
DEVICE=17a10040.wifi
P=/sys/bus/platform/devices/$DEVICE
MODULES=$LAB/stage7/modules
FIRMWARE=/run/current-system/firmware/ath11k/WCN6750/hw1.0

case ${1-} in
--start)
    [ "$#" -eq 1 ] || { echo "usage: $0 --start" >&2; exit 2; }
    : "${REDWOOD_EVIDENCE_ENDPOINT:?set the acknowledged np evidence endpoint}"
    : "${REDWOOD_EVIDENCE_RUN_ID:?set the evidence run identity}"
    case $REDWOOD_EVIDENCE_RUN_ID in
        *[!A-Za-z0-9_-]*|'') echo "invalid evidence run identity" >&2; exit 2 ;;
    esac
    EVIDENCE_HOST=${REDWOOD_EVIDENCE_ENDPOINT%:*}
    EVIDENCE_PORT=${REDWOOD_EVIDENCE_ENDPOINT##*:}
    [ -n "$EVIDENCE_HOST" ] && [ -n "$EVIDENCE_PORT" ]
    BOOT_ID=${REDWOOD_EVIDENCE_BOOT_ID:-$(cat /proc/sys/kernel/random/boot_id)}
    SERVICE_SHA=${REDWOOD_EVIDENCE_SERVICE_SHA:-$(sha256sum "$BIN/ath11k-wifi-service" | cut -d' ' -f1)}
    DIAGNOSTIC_SHA=${REDWOOD_EVIDENCE_DIAGNOSTIC_SHA:-$(sha256sum "$BIN/redwood-wifi-diagnostic" | cut -d' ' -f1)}
    ACK=$(printf 'run=%s stage=unit_submit boot_id=%s service_sha256=%s diagnostic_sha256=%s\n' \
        "$REDWOOD_EVIDENCE_RUN_ID" "$BOOT_ID" "$SERVICE_SHA" "$DIAGNOSTIC_SHA" | \
        "$NC" -w 2 "$EVIDENCE_HOST" "$EVIDENCE_PORT")
    [ "$ACK" = ACK ] || { echo "np evidence collector did not acknowledge unit submission" >&2; exit 1; }
    if "$SYSTEMCTL" is-active --quiet "$UNIT.service"; then
        echo "diagnostic unit is already active" >&2
        exit 1
    fi
    "$SYSTEMD_RUN" --quiet --collect --no-block --unit="$UNIT" \
        --setenv="REDWOOD_EVIDENCE_ENDPOINT=$REDWOOD_EVIDENCE_ENDPOINT" \
        --setenv="REDWOOD_EVIDENCE_RUN_ID=$REDWOOD_EVIDENCE_RUN_ID" \
        --setenv="REDWOOD_NETWORK_SERVICE=$NETWORK_SERVICE" \
        --setenv="REDWOOD_DIAGNOSTIC_PAUSE=${REDWOOD_DIAGNOSTIC_PAUSE:-}" \
        --setenv="REDWOOD_DIAGNOSTIC_VFIO_TRACE=${REDWOOD_DIAGNOSTIC_VFIO_TRACE:-}" \
        --property=Type=exec "$(readlink -f "$0")" --run
    echo "REDWOOD_WPA3_SUBMITTED unit=$UNIT.service log=$RUN/diagnostic.log"
    exit
    ;;
--self-test)
    [ "$#" -eq 1 ] || exit 2
    t=$(mktemp -d)
    trap 'rm -rf "$t"' EXIT
    cat >"$t/systemctl" <<'EOF'
#!/bin/sh
exit 3
EOF
    cat >"$t/systemd-run" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >"$REDWOOD_TEST_ACTIONS"
EOF
    cat >"$t/nc" <<'EOF'
#!/bin/sh
cat >/dev/null
echo ACK
EOF
    chmod +x "$t/systemctl" "$t/systemd-run" "$t/nc"
    REDWOOD_SYSTEMCTL="$t/systemctl" REDWOOD_SYSTEMD_RUN="$t/systemd-run" \
        REDWOOD_NC="$t/nc" REDWOOD_DIAGNOSTIC_PAUSE=mmio:0xb81fc \
        REDWOOD_DIAGNOSTIC_VFIO_TRACE=1 \
        REDWOOD_TEST_ACTIONS="$t/actions" REDWOOD_EVIDENCE_ENDPOINT=127.0.0.1:9 \
        REDWOOD_EVIDENCE_RUN_ID=selftest REDWOOD_EVIDENCE_BOOT_ID=selftest \
        REDWOOD_EVIDENCE_SERVICE_SHA=selftest REDWOOD_EVIDENCE_DIAGNOSTIC_SHA=selftest \
        PATH="$t:$PATH" "$0" --start >"$t/output"
    grep -q -- '--collect --no-block' "$t/actions"
    grep -q -- '--property=Type=exec' "$t/actions"
    grep -q -- '--setenv=REDWOOD_EVIDENCE_ENDPOINT=127.0.0.1:9' "$t/actions"
    grep -q -- '--setenv=REDWOOD_EVIDENCE_RUN_ID=selftest' "$t/actions"
    grep -q -- '--setenv=REDWOOD_DIAGNOSTIC_PAUSE=mmio:0xb81fc' "$t/actions"
    grep -q -- '--setenv=REDWOOD_DIAGNOSTIC_VFIO_TRACE=1' "$t/actions"
    grep -q -- '--run' "$t/actions"
    ! grep -Eq -- 'timeout|RuntimeMaxSec|KillSignal' "$t/actions"
    grep -q 'REDWOOD_WPA3_SUBMITTED' "$t/output"
    # An active diagnostic must refuse before submitting another unit. A bare
    # `! command` is exempt from `set -e` and does not enforce this gate.
    printf '#!/bin/sh\nexit 0\n' >"$t/systemctl"
    rm "$t/actions"
    if REDWOOD_SYSTEMCTL="$t/systemctl" REDWOOD_SYSTEMD_RUN="$t/systemd-run" \
        REDWOOD_NC="$t/nc" REDWOOD_TEST_ACTIONS="$t/actions" \
        REDWOOD_EVIDENCE_ENDPOINT=127.0.0.1:9 REDWOOD_EVIDENCE_RUN_ID=selftest \
        REDWOOD_EVIDENCE_BOOT_ID=selftest REDWOOD_EVIDENCE_SERVICE_SHA=selftest \
        REDWOOD_EVIDENCE_DIAGNOSTIC_SHA=selftest \
        "$0" --start >"$t/refused" 2>&1; then
        echo "active diagnostic was not refused" >&2
        exit 1
    fi
    test ! -e "$t/actions"
    grep -q 'diagnostic unit is already active' "$t/refused"
    echo REDWOOD_WPA3_SELF_TEST_OK
    exit
    ;;
--run)
    [ "$#" -eq 1 ] || { echo "usage: $0 --run" >&2; exit 2; }
    ;;
*)
    echo "usage: $0 --start|--self-test" >&2
    exit 2
    ;;
esac

mkdir -p "$RUN"
exec >>"$RUN/diagnostic.log" 2>&1
echo "REDWOOD_WPA3_BEGIN=$(date -u +%FT%TZ)"
sync -f "$RUN/diagnostic.log"

# This run has explicitly accepted manual recovery. Automatic reboot
# mechanisms remain absent, while the retained-candidate sleep inhibitor keeps
# the attended control path from being lost to idle suspend.
grep -qw 'rd.systemd.mask=boot-watchdog.service' /proc/cmdline
grep -qw 'rd.systemd.mask=redwood-lab-watchdog.service' /proc/cmdline
test ! -e /run/redwood-lab-watchdog/armed
test ! -e /dev/watchdog0
for unit in redwood-lab-watchdog.service boot-watchdog.service \
    ath11k-fast-cycle-deadline.timer ath11k-fast-cycle-deadline.service; do
    if systemctl is-active --quiet "$unit"; then
        echo "refusing active automatic recovery unit: $unit" >&2
        exit 1
    fi
done
systemctl is-active --quiet ath11k-redwood-sleep-inhibit-v2.service

test "$(wc -c </proc/device-tree/soc@0/wifi@17a10040/reg)" = 32
test "$(stat -c %U:%G:%a "$CREDENTIAL")" = root:root:600
test -x "$BIN/ath11k-wifi-service"
test -x "$BIN/redwood-wifi-diagnostic"
if [ -n "$NETWORK_SERVICE" ]; then test -x "$NETWORK_SERVICE"; fi
test -f "$FIRMWARE/board.bin"
test -f "$FIRMWARE/regdb.bin"
test -s "$LAB/stage13/client-mac"
test "$(cat "$RPROC/name")" = wpss
test "$(cat "$RPROC/state")" = offline
test ! -e "$P/driver"

# A firmware restart must not silently reuse the old userspace DMA/session
# generation. Keep the first crash visible until cooperative containment.
RPROC_DEBUG=/sys/kernel/debug/remoteproc/remoteproc2
printf disabled >"$RPROC_DEBUG/recovery"
printf enabled >"$RPROC_DEBUG/coredump"
test "$(cat "$RPROC_DEBUG/recovery")" = disabled
test "$(cat "$RPROC_DEBUG/coredump")" = enabled

printf 1 >/sys/module/iommufd/parameters/allow_unsafe_interrupts
test -d /sys/module/vfio_platform ||
    insmod "$MODULES/vfio-platform-base.ko"
test -d /sys/module/vfio_platform ||
    insmod "$MODULES/vfio-platform.ko" reset_required=0
printf start >"$RPROC/state"
test "$(cat "$RPROC/state")" = running
printf %s vfio-platform >"$P/driver_override"
printf %s "$DEVICE" >/sys/bus/platform/drivers/vfio-platform/bind
CDEV_NAME=$(find "$P/vfio-dev" -maxdepth 1 -mindepth 1 -printf '%f\n' | head -n1)
test -n "$CDEV_NAME"
CDEV=/dev/vfio/devices/$CDEV_NAME
test -c "$CDEV"

set +e
LC_ALL=C awk 'BEGIN { count=0 } /^Passphrase=/ { count++; value=substr($0,12) } END { if (count != 1 || length(value) < 8 || length(value) > 63) exit 1; printf "%s", value }' \
    "$CREDENTIAL" | "$BIN/redwood-wifi-diagnostic" \
    "$BIN/ath11k-wifi-service" "$CDEV" "$FIRMWARE/board.bin" \
    "$FIRMWARE/regdb.bin" 1 "$(cat "$LAB/stage13/client-mac")" "$RPROC"
RC=$?
set -e
echo "REDWOOD_WPA3_SERVICE_RC=$RC"

# Never release the platform device until the service has synchronously
# stopped WPSS and every process has released the VFIO cdev.
test "$(cat "$RPROC/state")" = offline
if find /proc/[0-9]*/fd -lname "$CDEV" -print -quit 2>/dev/null | grep -q .; then
    echo "REDWOOD_WPA3_LIVE_CDEV_FD=1"
    exit 1
fi
printf %s "$DEVICE" >/sys/bus/platform/drivers/vfio-platform/unbind
test ! -e "$P/driver"
echo "REDWOOD_WPA3_INERT=$(date -u +%FT%TZ)"
sync -f "$RUN/diagnostic.log"
exit "$RC"
