#!/bin/sh
# Lab-only same-kernel Run B loop. The runner stops WPSS while it still owns
# every VFIO mapping; this wrapper drops/rebinds VFIO only after `offline`.
set -eu

PATH=/run/current-system/sw/bin:/bin:/sbin
export PATH

LAB=${REDWOOD_LAB:-/var/lib/ath11k-redwood-lab}
RUN=${REDWOOD_RUN_DIR:-$LAB/runs/runB-fast-cycle}
RPROC=/sys/class/remoteproc/remoteproc2
DEVICE=17a10040.wifi
P=/sys/bus/platform/devices/$DEVICE
RUNNER=$LAB/stage10/ath11k-bringup-runB
TRANSACTION=$LAB/stage10/redwood-wifi-transaction
CYCLES=${REDWOOD_FAST_CYCLES:-2}
STOP_AFTER=${REDWOOD_STOP_AFTER:-core}
MANUAL_RECOVERY=${REDWOOD_MANUAL_RECOVERY:-0}

mkdir -p "$RUN"
exec >>"$RUN/fast-cycle.log" 2>&1
echo "FAST_BEGIN=$(date -u +%FT%TZ)"
sync -f "$RUN/fast-cycle.log"
sha256sum -c "$LAB/stage12/SHA256SUMS"
test "$(wc -c </proc/device-tree/soc@0/wifi@17a10040/reg)" = 32
test "$(cat "$RPROC/state")" = offline
test "$CYCLES" -ge 1
case "$STOP_AFTER" in
  core|passive-scan|scan-results) ;;
  *) echo "unsupported REDWOOD_STOP_AFTER=$STOP_AFTER"; exit 2 ;;
esac
case "$MANUAL_RECOVERY" in
  0|1) ;;
  *) echo "unsupported REDWOOD_MANUAL_RECOVERY=$MANUAL_RECOVERY"; exit 2 ;;
esac

# Keep USB control reachable after the clean final cycle leaves this candidate
# idle. The active-run transaction's inhibitor ends with that transaction and
# does not cover the retained same-kernel iteration window.
if ! systemctl is-active --quiet ath11k-redwood-sleep-inhibit-v2.service; then
  systemctl reset-failed ath11k-redwood-sleep-inhibit-v2.service 2>/dev/null || true
  systemd-run --quiet --unit=ath11k-redwood-sleep-inhibit-v2 \
    /run/current-system/sw/bin/systemd-inhibit --what=sleep \
      --who=ath11k-redwood-lab --why='retain USB control of inert candidate' \
      --mode=block /run/current-system/sw/bin/sleep infinity
fi
systemctl is-active --quiet ath11k-redwood-sleep-inhibit-v2.service

if test "$MANUAL_RECOVERY" = 1; then
  test ! -e /run/redwood-lab-watchdog/armed
  test ! -e /dev/watchdog0
  for unit in redwood-lab-watchdog.service boot-watchdog.service \
    ath11k-fast-cycle-deadline.timer ath11k-fast-cycle-deadline.service; do
    ! systemctl is-active --quiet "$unit"
  done
  echo "RECOVERY_MODE=manual automatic_watchdog=disabled hardware_watchdog=absent automatic_deadline=disabled"
  sync -f "$RUN/fast-cycle.log"
else
  "$LAB/watchdog-acceptance/redwood-lab-watchdog" arm "$RUN"
  systemd-run --quiet --unit=ath11k-fast-cycle-deadline --on-active=300s \
    "$TRANSACTION" --recover fast_cycle_deadline
fi

# Keep the smallest useful evidence durable across an abrupt reboot. The
# automatic mode's watchdog checks both the runner heartbeat and ICMP control
# reachability; this independent recorder captures those same inputs in either
# recovery mode and syncs the existing run logs without depending on the runner
# making forward progress.
record_flight_state() {
  uptime=$(cut -d' ' -f1 /proc/uptime 2>/dev/null || echo unavailable)
  runner_pid=$(cat /run/redwood-lab-watchdog/runner.pid 2>/dev/null || echo absent)
  heartbeat_mtime=$(stat -c %Y /run/redwood-lab-watchdog/heartbeat 2>/dev/null || echo absent)
  remoteproc_state=$(cat "$RPROC/state" 2>/dev/null || echo unavailable)
  usb_carrier=$(cat /sys/class/net/usb0/carrier 2>/dev/null || echo unavailable)
  if ping -c 1 -W 1 172.16.42.2 >/dev/null 2>&1; then
    control=reachable
  else
    control=lost
  fi
  printf 'uptime=%s runner_pid=%s heartbeat_mtime=%s remoteproc=%s usb_carrier=%s control=%s\n' \
    "$uptime" "$runner_pid" "$heartbeat_mtime" "$remoteproc_state" \
    "$usb_carrier" "$control" >>"$RUN/flight-recorder.log"
  for log in "$RUN/flight-recorder.log" "$RUN/fast-cycle.log" \
    "$RUN"/preflight-*.log "$RUN"/runB-*.log "$RUN"/runB-*.wmi.jsonl; do
    test ! -e "$log" || sync -f "$log"
  done
}

flight_recorder() {
  while :; do
    record_flight_state
    sleep 2
  done
}

flight_recorder &
flight_pid=$!
stop_flight_recorder() {
  kill "$flight_pid" 2>/dev/null || true
  wait "$flight_pid" 2>/dev/null || true
}
trap stop_flight_recorder EXIT INT TERM

printf 1 >/sys/module/iommufd/parameters/allow_unsafe_interrupts
test -d /sys/module/vfio_platform || \
  insmod "$LAB/stage7/modules/vfio-platform-base.ko"
test -d /sys/module/vfio_platform || \
  insmod "$LAB/stage7/modules/vfio-platform.ko" reset_required=0
printf %s vfio-platform >"$P/driver_override"

i=1
while test "$i" -le "$CYCLES"; do
  start_ns=$(date +%s%N)
  echo "CYCLE_${i}_START_NS=$start_ns"
  test "$(cat "$RPROC/state")" = offline
  printf start >"$RPROC/state"
  test "$(cat "$RPROC/state")" = running
  running_ns=$(date +%s%N)
  echo "CYCLE_${i}_RPROC_RUNNING_NS=$running_ns"

  printf %s "$DEVICE" >/sys/bus/platform/drivers/vfio-platform/bind
  cdev_name=$(find "$P/vfio-dev" -maxdepth 1 -mindepth 1 -printf '%f\n' | head -n1)
  cdev=/dev/vfio/devices/$cdev_name
  test -c "$cdev"
  manual_arg=
  if test "$MANUAL_RECOVERY" = 1; then
    manual_arg=--manual-recovery
  fi
  "$RUNNER" preflight --vfio-device "$cdev" $manual_arg >"$RUN/preflight-$i.log" 2>&1
  if test "$MANUAL_RECOVERY" = 0; then
    touch /run/redwood-lab-watchdog/run
  fi
  launch_ns=$(date +%s%N)
  echo "CYCLE_${i}_RUNNER_LAUNCH_NS=$launch_ns"
  sync -f "$RUN/fast-cycle.log"

  set +e
  "$RUNNER" --vfio-device "$cdev" --containment remoteproc:remoteproc2 \
    --stop-remoteproc-on-exit --register-region 1 --stop-after "$STOP_AFTER" \
    --wmi-log "$RUN/runB-$i.wmi.jsonl" $manual_arg >"$RUN/runB-$i.log" 2>&1
  rc=$?
  set -e
  record_flight_state
  offline_ns=$(date +%s%N)
  echo "CYCLE_${i}_RUNNER_RC=$rc OFFLINE_NS=$offline_ns RUN_TO_OFFLINE_MS=$(((offline_ns-running_ns)/1000000))"
  test "$(cat "$RPROC/state")" = offline

  # The child has returned only after WPSS stopped; now require its VFIO cdev
  # authority to be gone before detaching the platform device.
  if find /proc/[0-9]*/fd -lname "$cdev" -print -quit 2>/dev/null | grep -q .; then
    echo "CYCLE_${i}_LIVE_CDEV_FD=1"
    exit 1
  fi
  printf %s "$DEVICE" >/sys/bus/platform/drivers/vfio-platform/unbind
  test ! -e "$P/driver"
  end_ns=$(date +%s%N)
  echo "CYCLE_${i}_COMPLETE_NS=$end_ns TOTAL_MS=$(((end_ns-start_ns)/1000000))"
  i=$((i + 1))
done

stop_flight_recorder
trap - EXIT INT TERM

echo "FAST_COMPLETE=$(date -u +%FT%TZ)"
# Every child is reaped, WPSS is offline, and VFIO is unbound. Only at this
# proved inert boundary may the emergency fallbacks be disarmed; keep the
# candidate kernel alive for the next userspace iteration.
if test "$MANUAL_RECOVERY" = 0; then
  "$LAB/watchdog-acceptance/redwood-lab-watchdog" stop
  systemctl stop ath11k-fast-cycle-deadline.timer ath11k-fast-cycle-deadline.service \
    2>/dev/null || true
  systemctl reset-failed ath11k-fast-cycle-deadline.timer \
    ath11k-fast-cycle-deadline.service 2>/dev/null || true
fi
echo "FAST_INERT_CANDIDATE_RETAINED=$(date -u +%FT%TZ)"
