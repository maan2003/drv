#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
work=${1:-"$repo/target/sapphire-gap-wasm"}
source="$work/pigweed"
tool_repo="$work/nix-wasi-toolchain"
output_root="$work/bazel-output"
target=//pw_bluetooth_sapphire/host/gap:gap_test
gtest_arg=${SAPPHIRE_GTEST_ARG-}

: "${SAPPHIRE_PIGWEED_ARCHIVE:?run inside nix develop}"
rm -rf "$source" "$tool_repo"
mkdir -p \
  "$source" \
  "$tool_repo/bin" \
  "$tool_repo/include/c++/v1" \
  "$tool_repo/include/x86_64-unknown-linux-gnu/c++/v1" \
  "$tool_repo/lib/clang/21/include"
touch \
  "$tool_repo/include/c++/v1/placeholder" \
  "$tool_repo/include/x86_64-unknown-linux-gnu/c++/v1/placeholder" \
  "$tool_repo/lib/clang/21/include/placeholder"
tar -xzf "$SAPPHIRE_PIGWEED_ARCHIVE" -C "$source"

cxx=$(command -v wasm32-unknown-wasip1-clang++)
cc=$(command -v wasm32-unknown-wasip1-clang)
bash_path=$(command -v bash)
python=$(command -v python3)
wasm_ld_dir=$(dirname "$(command -v wasm-ld)")
coreutils_bin=$(dirname "$(command -v sort)")
resource_include="$($cxx --print-resource-dir)/include"
search_paths=$(printf '' | "$cxx" -E -x c++ -v - 2>&1)
libcxx_include=$(printf '%s\n' "$search_paths" | sed -n 's/^ \(\/nix\/store\/.*libcxx-static.*\/include\/c++\/v1\)$/\1/p' | head -1)
wasi_include=$(printf '%s\n' "$search_paths" | sed -n 's/^ \(\/nix\/store\/.*wasilibc-static.*\/include\/wasm32-wasip1\)$/\1/p' | head -1)
libcxx_lib=$(printf '%s\n' "$NIX_LDFLAGS" | grep -o -- '-L/nix/store/[^ ]*libcxx-static[^ ]*/lib' | head -1 | cut -c3-)

"$python" - "$source" "$tool_repo" "$python" "$gtest_arg" <<'PY'
import json
from pathlib import Path
import sys

source, tool_repo, python = map(Path, sys.argv[1:4])
gtest_arg = sys.argv[4]
(source / "wasi_test_args.h").write_text(
    "#pragma once\n\n"
    + "static char drv_gtest_arg_0[] = \"gap_test\";\n"
    + ((f"static char drv_gtest_arg_1[] = {json.dumps(gtest_arg)};\n") if gtest_arg else "")
    + "static char* drv_gtest_args[] = {\n"
    + "    drv_gtest_arg_0,\n"
    + (("    drv_gtest_arg_1,\n") if gtest_arg else "")
    + "};\n"
    + "static const size_t drv_gtest_arg_count = "
    + ("2;\n" if gtest_arg else "1;\n")
)
module = source / "MODULE.bazel"
text = module.read_text()
toolchains = '''pw_cxx_toolchain.llvm(cipd_tag = LLVM_VERSION)
pw_cxx_toolchain.arm_gcc(cipd_tag = "version:2@15.2.rel1.1")
pw_cxx_toolchain.zephyr_gcc(cipd_tag = "version:3@1.0.0")
pw_cxx_toolchain.zephyr_llvm(cipd_tag = "version:3@1.0.0")
use_repo(pw_cxx_toolchain, "gcc_arm_none_eabi_toolchain", "llvm_toolchain", "zephyr_llvm_toolchain", "zephyr_toolchain")
'''
linux_sysroot = '''# Fetch linux sysroot for host builds.
cipd_ext.require(
    name = "pigweed.linux_sysroot",
    build_file = "//pw_toolchain/host_clang:linux_sysroot.BUILD",
    packages = {
        "fuchsia/third_party/sysroot/bionic": "git_revision:702eb9654703a7cec1cadf93a7e3aa269d053943",
    },
)
use_repo(cipd_ext, linux_sysroot = "pigweed.linux_sysroot")

'''
upstream_python = '''python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    # Allows building as root in a docker container. Required by oss-fuzz.
    ignore_root_user_error = True,
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "pythons_hub")
'''
local_python = f'''local_runtime_repo = use_repo_rule(
    "@rules_python//python/local_toolchains:repos.bzl",
    "local_runtime_repo",
)
local_runtime_toolchains_repo = use_repo_rule(
    "@rules_python//python/local_toolchains:repos.bzl",
    "local_runtime_toolchains_repo",
)
local_runtime_repo(
    name = "nix_python3",
    interpreter_path = "{python}",
    on_failure = "fail",
)
local_runtime_toolchains_repo(
    name = "nix_python_toolchains",
    runtimes = ["nix_python3"],
)
'''
for old in (toolchains, linux_sysroot, upstream_python):
    if old not in text:
        raise SystemExit("pinned Pigweed patch context changed")
text = text.replace(toolchains, "").replace(linux_sysroot, "").replace(upstream_python, local_python)
text = text.replace('register_toolchains("@pythons_hub//:all")', 'register_toolchains("@nix_python_toolchains//:all")')
text += f'''\nlocal_repository(\n    name = "llvm_toolchain",\n    path = "{tool_repo}",\n)\n'''
module.write_text(text)

host = source / "pw_toolchain/host_clang/BUILD.bazel"
text = host.read_text()
text = text.replace('''        "@platforms//os:linux": [
            "@llvm_toolchain//:include-x86_64-unknown-linux-gnu-c++-v1",
            "@llvm_toolchain//:include-c++-v1",
            "@llvm_toolchain//:lib-clang-include",
            "@linux_sysroot//:usr-include-x86_64-linux-gnu",
            "@linux_sysroot//:usr-include-arm-linux-gnueabihf",
            "@linux_sysroot//:usr-include",
        ],''', '''        "@platforms//os:linux": [
            "@llvm_toolchain//:include-c++-v1",
            "@llvm_toolchain//:lib-clang-include",
        ],''')
text = text.replace('"@platforms//os:linux": "@linux_sysroot//:sysroot",', '"@platforms//os:linux": "@rules_cc//:empty_lib",')
text = text.replace('''        "@platforms//os:linux": [
            ":linux_link_libs",
            "@linux_sysroot//:sysroot",
        ],''', '''        "@platforms//os:linux": [
            "@llvm_toolchain//:wasm_compile_args",
            "@llvm_toolchain//:wasm_link_args",
        ],''')
host.write_text(text)

baremetal = source / "pw_sync_baremetal/BUILD.bazel"
baremetal.write_text(baremetal.read_text().replace('    target_compatible_with = ["@platforms//os:none"],\n', ''))

gap = source / "pw_bluetooth_sapphire/host/gap/BUILD.bazel"
text = gap.read_text()
marker = '    test_main = "//pw_bluetooth_sapphire/host/testing:gtest_main",\n    deps = [\n        ":gap",'
replacement = marker + '\n        "//:wasi_test_stubs",'
if marker not in text:
    raise SystemExit("pinned GAP test patch context changed")
gap.write_text(text.replace(marker, replacement, 1))
PY

cp "$repo/crates/bluetooth-sapphire-wasm/upstream/wasi_test_stubs.c" "$source/"
cat >>"$source/BUILD.bazel" <<'EOF'

cc_library(
    name = "wasi_test_stubs",
    srcs = ["wasi_test_stubs.c"],
    hdrs = ["wasi_test_args.h"],
    visibility = ["//visibility:public"],
)
EOF

make_wrapper() {
  local name=$1 target_path=$2
  cat >"$tool_repo/bin/$name" <<EOF
#!$bash_path
set -eu
export PATH=$wasm_ld_dir:\$PATH
args=()
for arg in "\$@"; do
  case "\$arg" in -pthread) ;; *) args+=("\$arg") ;; esac
done
exec "$target_path" "\${args[@]}"
EOF
  chmod +x "$tool_repo/bin/$name"
}
make_wrapper clang "$cc"
make_wrapper clang++ "$cxx"
make_wrapper lld "$cxx"
for tool in ar nm objdump readelf size objcopy strip; do
  make_wrapper "llvm-$tool" "$(command -v wasm32-unknown-wasip1-$tool)"
done

cat >"$tool_repo/BUILD.bazel" <<EOF
load("@bazel_skylib//rules/directory:directory.bzl", "directory")
load("@bazel_skylib//rules/directory:subdirectory.bzl", "subdirectory")
load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains:tool.bzl", "cc_tool")
load("@rules_cc//cc/toolchains:tool_map.bzl", "cc_tool_map")
package(default_visibility = ["//visibility:public"])
exports_files(glob(["bin/*"]))
cc_tool(name = "clang", src = "bin/clang")
cc_tool(name = "clang++", src = "bin/clang++")
cc_tool(name = "lld", src = "bin/lld")
cc_tool(name = "llvm-ar", src = "bin/llvm-ar")
cc_tool(name = "llvm-nm", src = "bin/llvm-nm")
cc_tool(name = "llvm-objdump", src = "bin/llvm-objdump")
cc_tool(name = "llvm-readelf", src = "bin/llvm-readelf")
cc_tool(name = "llvm-size", src = "bin/llvm-size")
cc_tool(name = "llvm-objcopy", src = "bin/llvm-objcopy")
cc_tool(name = "llvm-strip", src = "bin/llvm-strip")
cc_tool_map(name = "all_tools", tools = {
  "@pigweed//pw_toolchain/action:cov": ":llvm-nm",
  "@pigweed//pw_toolchain/action:gcov": ":llvm-nm",
  "@pigweed//pw_toolchain/action:nm": ":llvm-nm",
  "@pigweed//pw_toolchain/action:objdump_disassemble": ":llvm-objdump",
  "@pigweed//pw_toolchain/action:readelf": ":llvm-readelf",
  "@pigweed//pw_toolchain/action:size": ":llvm-size",
  "@rules_cc//cc/toolchains/actions:assembly_actions": ":clang",
  "@rules_cc//cc/toolchains/actions:c_compile_actions": ":clang",
  "@rules_cc//cc/toolchains/actions:cpp_compile_actions": ":clang++",
  "@rules_cc//cc/toolchains/actions:link_actions": ":lld",
  "@rules_cc//cc/toolchains/actions:ar_actions": ":llvm-ar",
  "@rules_cc//cc/toolchains/actions:objcopy_embed_data": ":llvm-objcopy",
  "@rules_cc//cc/toolchains/actions:strip": ":llvm-strip",
})
filegroup(name = "clang-tidy", srcs = [])
filegroup(name = "llvm-libc_args", srcs = [])
filegroup(name = "py_clang_format", srcs = [])
directory(name = "toolchain_root", srcs = glob(["lib/**", "include/**"], allow_empty = True))
subdirectory(name = "include-c++-v1", parent = ":toolchain_root", path = "include/c++/v1")
subdirectory(name = "include-x86_64-unknown-linux-gnu-c++-v1", parent = ":toolchain_root", path = "include/x86_64-unknown-linux-gnu/c++/v1")
subdirectory(name = "lib-clang-include", parent = ":toolchain_root", path = "lib/clang/21/include")
cc_args(
  name = "wasm_compile_args",
  actions = [
    "@rules_cc//cc/toolchains/actions:assembly_actions",
    "@rules_cc//cc/toolchains/actions:c_compile_actions",
    "@rules_cc//cc/toolchains/actions:cpp_compile_actions",
  ],
  args = ["-D_WASI_EMULATED_SIGNAL", "-DGTEST_HAS_FILE_SYSTEM=0", "-DGTEST_HAS_PTHREAD=0", "-DGTEST_HAS_DEATH_TEST=0"],
  allowlist_absolute_include_directories = ["$resource_include", "$wasi_include", "$libcxx_include"],
)
cc_args(
  name = "wasm_link_args",
  actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
  args = ["-L$libcxx_lib", "-lwasi-emulated-signal", "-mexec-model=reactor", "-Wl,--export=__main_argc_argv", "-Wl,--gc-sections", "-Wl,--strip-all"],
)
EOF
: >"$tool_repo/MODULE.bazel"

cd "$source"
startup_args=(
  --output_user_root="$output_root"
)
build_args=(
  --spawn_strategy=local
  --action_env=PATH="$coreutils_bin"
  --features=-layering_check
  --workspace_status_command="$(command -v true)"
  --//pw_unit_test:backend=//pw_unit_test:googletest
  --//pw_sync:mutex_backend=//pw_sync_baremetal:mutex
  --//pw_sync:recursive_mutex_backend=//pw_sync_baremetal:recursive_mutex
)
bazel "${startup_args[@]}" fetch "${build_args[@]}" "$target"

rules_python=$(find "$output_root" -mindepth 3 -maxdepth 3 -type d -path '*/external/rules_python+' -print -quit)
googletest=$(find "$output_root" -mindepth 3 -maxdepth 3 -type d -path '*/external/googletest+' -print -quit)
: "${rules_python:?Bazel did not fetch rules_python}"
: "${googletest:?Bazel did not fetch googletest}"
sed -i "1c#!$bash_path" "$rules_python/python/private/stage1_bootstrap_template.sh"
sed -i "s|^  env$|  $(command -v env)|" "$rules_python/python/private/stage1_bootstrap_template.sh"
sed -i 's/build_setting_default = BootstrapImplFlag.SYSTEM_PYTHON/build_setting_default = BootstrapImplFlag.SCRIPT/' "$rules_python/python/config_settings/BUILD.bazel"
find "$googletest/googletest/include" "$googletest/googletest/src" -type f \( -name '*.h' -o -name '*.cc' \) \
  -exec sed -i 's/^#ifdef GTEST_HAS_DEATH_TEST$/#if GTEST_HAS_DEATH_TEST/' {} +

bazel "${startup_args[@]}" build "${build_args[@]}" "$target"
artifact="$source/bazel-bin/pw_bluetooth_sapphire/host/gap/gap_test"
wasm-tools validate "$artifact"
printf '%s\n' "$artifact"
