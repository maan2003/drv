#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

(cd lab/probe && cargo component bindings)
cargo fmt --all
cargo build -p drv-probe --target wasm32-unknown-unknown
wasm-tools component new \
  target/wasm32-unknown-unknown/debug/drv_probe.wasm \
  -o target/drv-probe.component.wasm
wasm-tools validate target/drv-probe.component.wasm
cargo clippy --workspace --all-targets -- -D warnings
DRV_PROBE_COMPONENT="$root/target/drv-probe.component.wasm" \
  cargo test --workspace
