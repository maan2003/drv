#!/usr/bin/env bash
set -euo pipefail

commit=1e1219e3fac944c9a906aea9646939746b6062b3

if [[ ${1:-} == --print-commit ]]; then
  printf "%s\n" "$commit"
  exit 0
fi
root="reference/fuchsia-$commit"

mkdir -p reference

paths=(
  src/connectivity/bluetooth
  src/connectivity/network/netstack3
  src/connectivity/network/dhcpv4/client/core
  src/connectivity/network/dhcpv4/protocol
  src/connectivity/network/dns
  src/connectivity/policy/netcfg
  src/connectivity/wlan
  src/lib/mundane
  src/lib/fuchsia-sync
  src/connectivity/lib/net-types
  src/connectivity/lib/net-declare
  src/connectivity/lib/internet-checksum
  src/connectivity/lib/packet-formats
  src/connectivity/network/lib/diagnostics-traits
  src/connectivity/network/lib/explicit
  src/media/audio/drivers/testing
  src/media/audio/drivers/virtual-audio
  src/media/audio/lib/clock
  src/media/audio/lib/processing
  src/media/audio/lib/timeline
  src/media/audio/services/device_registry
  src/media/audio/services/mixer
  src/lib/network/packet
  src/lib/replace-with
  third_party/rust_crates/forks/trust-dns-proto-0.22.0
  third_party/rust_crates/forks/trust-dns-resolver-0.22.0
  third_party/boringssl/rust
  sdk/fidl/fuchsia.audio
  sdk/fidl/fuchsia.audio.effects
  sdk/fidl/fuchsia.bluetooth
  sdk/fidl/fuchsia.bluetooth.a2dp
  sdk/fidl/fuchsia.bluetooth.bredr
  sdk/fidl/fuchsia.bluetooth.fastpair
  sdk/fidl/fuchsia.bluetooth.gatt
  sdk/fidl/fuchsia.bluetooth.gatt2
  sdk/fidl/fuchsia.bluetooth.hfp
  sdk/fidl/fuchsia.bluetooth.host
  sdk/fidl/fuchsia.bluetooth.le
  sdk/fidl/fuchsia.bluetooth.sys
  sdk/fidl/fuchsia.bluetooth.test
  sdk/fidl/fuchsia.hardware.audio
  sdk/fidl/fuchsia.hardware.audio.signalprocessing
  sdk/fidl/fuchsia.hardware.bluetooth
  sdk/fidl/fuchsia.wlan.common
  sdk/fidl/fuchsia.wlan.driver
  sdk/fidl/fuchsia.wlan.ieee80211
  sdk/fidl/fuchsia.wlan.internal
  sdk/fidl/fuchsia.wlan.minstrel
  sdk/fidl/fuchsia.wlan.mlme
  sdk/fidl/fuchsia.wlan.sme
  sdk/fidl/fuchsia.wlan.softmac
  sdk/fidl/fuchsia.wlan.stats
)

# Additional pinned paths may be supplied by package overlays. This keeps one
# project pin/archive/hash convention while avoiding duplicate fetch scripts.
for path in "$@"; do
  if [[ -z "$path" || "$path" == /* || "$path" == *..* ]]; then
    printf "invalid Fuchsia repository path: %s\n" "$path" >&2
    exit 2
  fi
  paths+=("$path")
done

for path in "${paths[@]}"; do
  name=${path//\//_}
  archive="reference/fuchsia-${name}-${commit}.tar.gz"

  if [[ ! -f "$archive" ]]; then
    curl -fL --retry 3 \
      "https://fuchsia.googlesource.com/fuchsia/+archive/$commit/$path.tar.gz" \
      -o "$archive"
  fi

  sha256sum "$archive" >"$archive.sha256"
  rm -rf "$root/$path"
  mkdir -p "$root/$path"
  tar -xzf "$archive" -C "$root/$path"
done

# BoringSSL is a gitlink in fuchsia.git, so fetch the exact revision recorded
# by the pinned Fuchsia tree separately into its expected checkout path.
boringssl_commit=156c7b75ae9b8c3b3f847acf264f17594c3859fb
boringssl_archive="reference/boringssl-$boringssl_commit.tar.gz"
boringssl_root="$root/third_party/boringssl/src"

if [[ ! -f "$boringssl_archive" ]]; then
  curl -fL --retry 3 \
    "https://boringssl.googlesource.com/boringssl/+archive/$boringssl_commit.tar.gz" \
    -o "$boringssl_archive"
fi

sha256sum "$boringssl_archive" >"$boringssl_archive.sha256"
rm -rf "$boringssl_root"
mkdir -p "$boringssl_root"
tar -xzf "$boringssl_archive" -C "$boringssl_root"
printf '%s\n' "$boringssl_commit" >"$root/third_party/boringssl/COMMIT"

printf '%s\n' "$commit" >"$root/COMMIT"

# Fuchsia's core Sapphire host stack moved to Pigweed and is consumed as a
# prebuilt by fuchsia.git. Keep its source beside the Fuchsia integration and
# Rust profile layers.
pigweed_commit=c14c119c51a82f6e044f81b7dad0a322091d4121
pigweed_archive="reference/pigweed-pw_bluetooth_sapphire-$pigweed_commit.tar.gz"
pigweed_root="reference/pigweed-$pigweed_commit/pw_bluetooth_sapphire"

if [[ ! -f "$pigweed_archive" ]]; then
  curl -fL --retry 3 \
    "https://pigweed.googlesource.com/pigweed/pigweed/+archive/$pigweed_commit/pw_bluetooth_sapphire.tar.gz" \
    -o "$pigweed_archive"
fi

sha256sum "$pigweed_archive" >"$pigweed_archive.sha256"
rm -rf "$pigweed_root"
mkdir -p "$pigweed_root"
tar -xzf "$pigweed_archive" -C "$pigweed_root"
printf '%s\n' "$pigweed_commit" >"$(dirname "$pigweed_root")/COMMIT"
