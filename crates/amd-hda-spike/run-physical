#!/usr/bin/env bash
set -euo pipefail

watchdog_seconds=${DRV_HDA_WATCHDOG_SECONDS:-20}
fail() { printf 'amd-hda physical guard: %s\n' "$*" >&2; exit 2; }

# PCI numbering and IOMMU group numbers are not stable across boots. Select by
# the complete hardware identity and class on every invocation.
matches=()
for candidate in /sys/bus/pci/devices/*; do
  [[ -r $candidate/class && -r $candidate/vendor && -r $candidate/device ]] || continue
  class=$(cat "$candidate/class")
  [[ ${class%??} == 0x0403 ]] || continue
  [[ $(cat "$candidate/vendor") == 0x1022 && $(cat "$candidate/device") == 0x15e3 ]] || continue
  [[ $(cat "$candidate/subsystem_vendor") == 0x1043 && $(cat "$candidate/subsystem_device") == 0x1513 ]] || continue
  matches+=("$candidate")
done
[[ ${#matches[@]} == 1 ]] || fail "expected exactly one 0403/1022:15e3/1043:1513 function; found ${#matches[@]}"
dev=${matches[0]}
bdf=${dev##*/}
class=$(cat "$dev/class")
[[ ${class%??} != 0x0280 ]] || fail "refusing Wi-Fi-class function $bdf"

group=$(readlink -f "$dev/iommu_group")
[[ -n $group && -d $group/devices ]] || fail "$bdf has no IOMMU group"
mapfile -t members < <(find "$group/devices" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort)
for member in "${members[@]}"; do
  member_class=$(cat "/sys/bus/pci/devices/$member/class")
  [[ ${member_class%??} != 0x0280 ]] || fail "IOMMU group ${group##*/} contains Wi-Fi function $member"
done
[[ ${#members[@]} == 1 && ${members[0]} == "$bdf" ]] || fail "IOMMU group ${group##*/} is not isolated: ${members[*]}"
[[ $(basename "$(readlink -f "$dev/driver")") == snd_hda_intel ]] || fail 'snd_hda_intel does not own the function'
[[ $EUID == 0 ]] || fail "selected $bdf in isolated group ${group##*/}; rerun as root"

# iommufd can be modular. Only diagnose the device node after trying to load it.
modprobe iommufd || fail 'cannot load iommufd (kernel CONFIG_IOMMUFD/module unavailable)'
[[ -c /dev/iommu ]] || fail '/dev/iommu did not appear after modprobe iommufd; check CONFIG_IOMMUFD and device-node policy'

cargo build -p amd-hda-spike --bin amd-hda-enumerate
modprobe vfio-pci
watchdog_pid=
restore() {
  local status=$?
  trap - EXIT INT TERM
  if [[ -n ${watchdog_pid:-} ]]; then kill "$watchdog_pid" 2>/dev/null || true; wait "$watchdog_pid" 2>/dev/null || true; fi
  if [[ -e $dev/driver && $(basename "$(readlink -f "$dev/driver")") == vfio-pci ]]; then echo "$bdf" > /sys/bus/pci/drivers/vfio-pci/unbind || true; fi
  echo snd_hda_intel > "$dev/driver_override" || true
  modprobe snd_hda_intel || true
  echo "$bdf" > /sys/bus/pci/drivers/snd_hda_intel/bind || true
  printf '\n' > "$dev/driver_override" || true
  if [[ ! -e $dev/driver || $(basename "$(readlink -f "$dev/driver")") != snd_hda_intel ]]; then
    printf 'amd-hda: native driver restoration failed; reboot is required\n' >&2
    status=1
  else
    printf 'amd-hda: verified native restore of %s to snd_hda_intel\n' "$bdf"
  fi
  exit "$status"
}
trap restore EXIT INT TERM

# The independent watchdog first attempts native recovery. If the process and
# EXIT trap are wedged and VFIO still owns this no-FLR function, force reboot.
(
  sleep "$watchdog_seconds"
  printf 'amd-hda: watchdog expired; attempting native recovery\n' >&2
  if [[ -e $dev/driver && $(basename "$(readlink -f "$dev/driver")") == vfio-pci ]]; then
    echo "$bdf" > /sys/bus/pci/drivers/vfio-pci/unbind 2>/dev/null || true
    echo snd_hda_intel > "$dev/driver_override" 2>/dev/null || true
    modprobe snd_hda_intel 2>/dev/null || true
    echo "$bdf" > /sys/bus/pci/drivers/snd_hda_intel/bind 2>/dev/null || true
  fi
  sleep 2
  if [[ ! -e $dev/driver || $(basename "$(readlink -f "$dev/driver")") != snd_hda_intel ]]; then
    systemctl reboot --force --force
  fi
) & watchdog_pid=$!

echo vfio-pci > "$dev/driver_override"
echo "$bdf" > "$dev/driver/unbind"
echo "$bdf" > /sys/bus/pci/drivers/vfio-pci/bind
for _ in {1..50}; do
  cdev=$(find "$dev/vfio-dev" -mindepth 1 -maxdepth 1 -printf '%f' 2>/dev/null || true)
  [[ -n $cdev && -c /dev/vfio/devices/$cdev ]] && break
  sleep .02
done
[[ -n ${cdev:-} && -c /dev/vfio/devices/$cdev ]] || fail 'VFIO device cdev did not appear'

timeout --signal=TERM "$((watchdog_seconds - 2))" target/debug/amd-hda-enumerate "/dev/vfio/devices/$cdev"
