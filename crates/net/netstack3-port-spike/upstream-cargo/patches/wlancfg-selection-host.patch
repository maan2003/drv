+#[cfg(feature = "host-selection")]
+impl SavedNetworksManager {
+    /// Load saved networks from an explicitly supplied, already-open directory.
+    ///
+    /// The directory capability is required because durable atomic replacement
+    /// cannot be implemented from a single already-open regular file.
+    pub async fn new_with_directory(
+        directory: File,
+        telemetry_sender: TelemetrySender,
+    ) -> Result<Self, PersistenceError> {
+        let mut store = PolicyStorage::new(directory)?;
+        let stored_networks = store.load()?;
+        let mut saved_networks = HashMap::with_capacity(stored_networks.len());
+        for persisted_data in stored_networks {
+            let id = NetworkIdentifier::new(
+                types::Ssid::from_bytes_unchecked(persisted_data.ssid),
+                persisted_data.security_type,
+            );
+            let config = NetworkConfig::new(
+                id.clone(),
+                persisted_data.credential,
+                persisted_data.has_ever_connected,
+                persisted_data.hidden_probability,
+            )
+            .map_err(|_| PersistenceError::invalid_config())?;
+            if saved_networks.insert(id, config).is_some() {
+                return Err(PersistenceError::invalid_config());
+            }
+        }
+        Ok(Self {
+            saved_networks: Mutex::new(saved_networks),
+            store: Mutex::new(store),
+            telemetry_sender,
+        })
+    }
+}
