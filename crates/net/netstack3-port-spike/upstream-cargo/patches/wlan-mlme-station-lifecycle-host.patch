 impl States {
+    /// A loss report only applies to an established association. Retire device
+    /// state before notifying SME, which may immediately revoke this operation.
+    pub async fn on_connection_loss<D: DeviceOps>(self, sta: &mut BoundClient<'_, D>) -> States {
+        match self {
+            States::Associated(mut state) => {
+                state.pre_leaving_associated_state(sta).await;
+                if let Err(e) = sta.clear_association().await {
+                    error!("Failed to clear association after firmware connection loss: {}", e);
+                }
+                sta.send_deauthenticate_ind(
+                    fidl_ieee80211::ReasonCode::LeavingNetworkDeauth,
+                    LocallyInitiated(true),
+                );
+                state.transition_to(Joined).into()
+            }
+            _ => self,
+        }
+    }
+
     /// Returns the STA's initial state.
     pub fn new_initial() -> States {
         States::from(State::new(Joined))
