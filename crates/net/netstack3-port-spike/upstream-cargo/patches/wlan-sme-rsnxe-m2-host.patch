+/// The RSNXE the host MLME places in an SAE (Re)Association Request: the
+/// selected BSS's single-octet RSNXE when it advertises SAE hash-to-element.
+/// IEEE Std 802.11-2020, 12.7.6.3 requires EAPOL-Key message 2/4 to repeat
+/// exactly this element, so the supplicant is handed the same raw bytes.
+fn sae_association_rsnxe(bss: &BssDescription) -> Option<Vec<u8>> {
+    let ies = bss.ies();
+    let mut cursor = 0usize;
+    let mut rsnxe = None;
+    while cursor + 2 <= ies.len() {
+        let len = usize::from(ies[cursor + 1]);
+        let next = cursor + 2 + len;
+        if next > ies.len() {
+            return None;
+        }
+        if ies[cursor] == ie::Id::RSNXE.0 {
+            if rsnxe.is_some() || len != 1 {
+                return None;
+            }
+            rsnxe = Some(ies[cursor..next].to_vec());
+        }
+        cursor = next;
+    }
+    rsnxe.filter(|raw| raw[2] & 0x20 != 0)
+}
