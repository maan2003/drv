+    pub fn on_trusted_mlme_scan_end<P>(
+        &mut self,
+        msg: fidl_mlme::ScanEnd,
+        state: &mut TrustedScanState<P>,
+        sme_inspect: &Arc<inspect::SmeTree>,
+        validate: impl FnOnce(&[TrustedScanInput<P>], &[TrustedScanAggregate]) -> bool,
+    ) -> Result<TrustedScanTerminal<P>, TrustedScanError> {
+        if state.terminal_seen {
+            if let Some(tag) = &mut self.trusted {
+                tag.poisoned = true;
+            }
+            return Err(TrustedScanError::DuplicateOrLate);
+        }
+        state.terminal_seen = true;
+        let Some(tag) = self.trusted.as_mut() else {
+            return Err(TrustedScanError::Inactive);
+        };
+        let ordinary_empty = self.pending_discovery.is_empty()
+            && self.scheduled_scan_receivers.is_empty()
+            && self.trusted_quarantine.is_empty()
+            && self.trusted_scheduled_quarantine.is_empty()
+            && self.trusted_scheduled_senders.is_empty()
+            && self.trusted_value_quarantine.is_empty();
+        let current = mem::replace(&mut self.current, ScanState::NotScanning);
+        let ScanState::ScanningTrusted {
+            generation,
+            mlme_txn_id,
+            bss_map,
+        } = current
+        else {
+            if let ScanState::ScanningToDiscover { cmd, bss_map, .. } = current {
+                self.trusted_quarantine.push(cmd);
+                self.trusted_value_quarantine.push(bss_map);
+            }
+            tag.poisoned = true;
+            return Err(TrustedScanError::Mismatch);
+        };
+        let clean = !tag.poisoned
+            && state.in_flight.is_none()
+            && tag.txn_id == msg.txn_id
+            && tag.generation == state.generation
+            && state.txn_id == Some(msg.txn_id)
+            && mlme_txn_id == msg.txn_id
+            && generation == state.generation
+            && msg.code == fidl_mlme::ScanResultCode::Success
+            && ordinary_empty;
+        if !clean {
+            self.trusted_value_quarantine.push(bss_map);
+            tag.poisoned = true;
+            return Err(
+                if tag.txn_id != msg.txn_id || tag.generation != state.generation {
+                    TrustedScanError::Mismatch
+                } else {
+                    TrustedScanError::Failed
+                },
+            );
+        }
