+fn corrupt_trusted_structure_for_test<P>(
+    inputs: &mut [TrustedScanInput<P>],
+    aggregates: &mut Vec<TrustedScanAggregate>,
+    corruption: TrustedScanCorruption,
+) {
+    match corruption {
+        TrustedScanCorruption::AcceptedPermutation => {
+            let indices = &mut aggregates
+                .iter_mut()
+                .find(|aggregate| aggregate.lineage.merger_input_indices.len() >= 2)
+                .expect("test requires accepted inputs")
+                .lineage
+                .merger_input_indices;
+            let last = indices.len() - 1;
+            indices.swap(0, last);
+        }
+        TrustedScanCorruption::DroppedPermutation => {
+            let indices = &mut aggregates
+                .iter_mut()
+                .find(|aggregate| aggregate.lineage.dropped_input_indices.len() >= 2)
+                .expect("test requires dropped inputs")
+                .lineage
+                .dropped_input_indices;
+            indices.swap(0, 1);
+        }
+        TrustedScanCorruption::BadEncounter => {
+            inputs
+                .first_mut()
+                .expect("test requires input")
+                .encounter_index += 1;
+        }
+        TrustedScanCorruption::BadTableIndex => {
+            inputs.first_mut().expect("test requires input").table_index += 1;
+        }
+        TrustedScanCorruption::ProducedBindingPermutation => {
+            assert!(inputs.len() >= 2, "test requires two inputs");
+            let (first, rest) = inputs.split_at_mut(1);
+            mem::swap(&mut first[0].provenance, &mut rest[0].provenance);
+        }
+        TrustedScanCorruption::BadTxnId => {
+            inputs
+                .first_mut()
+                .expect("test requires input")
+                .original_result
+                .txn_id += 1;
+        }
+        TrustedScanCorruption::BadTimestamp => {
+            inputs
+                .first_mut()
+                .expect("test requires input")
+                .original_result
+                .timestamp_nanos += 1;
+        }
+        TrustedScanCorruption::DuplicateRole => {
+            let lineage = &mut aggregates
+                .first_mut()
+                .expect("test requires aggregate")
+                .lineage;
+            lineage
+                .dropped_input_indices
+                .push(lineage.merger_input_indices[0]);
+            lineage.occupied_predicate_evaluations += 1;
+        }
+        TrustedScanCorruption::MissingRole => {
+            let lineage = &mut aggregates
+                .first_mut()
+                .expect("test requires aggregate")
+                .lineage;
+            assert!(lineage.merger_input_indices.len() >= 2);
+            lineage.merger_input_indices.remove(0);
+            lineage.occupied_predicate_evaluations -= 1;
+        }
+        TrustedScanCorruption::CrossBssidAssignment => {
+            assert!(aggregates.len() >= 2, "test requires two BSSIDs");
+            let foreign = aggregates[1].lineage.representative_index;
+            aggregates[0].lineage.merger_input_indices[0] = foreign;
+        }
+        TrustedScanCorruption::InvalidRepresentative => {
+            aggregates
+                .first_mut()
+                .expect("test requires aggregate")
+                .lineage
+                .representative_index = usize::MAX;
+        }
+        TrustedScanCorruption::NonLastRepresentative => {
+            let lineage = &mut aggregates
+                .first_mut()
+                .expect("test requires aggregate")
+                .lineage;
+            assert!(lineage.merger_input_indices.len() >= 2);
+            lineage.representative_index = lineage.merger_input_indices[0];
+        }
+        TrustedScanCorruption::RepresentativeFixedField(field) => {
+            let bss = &mut aggregates
+                .first_mut()
+                .expect("test requires aggregate")
+                .fixed_bss;
+            match field {
+                TrustedFixedField::Bssid => bss.bssid[0] ^= 1,
+                TrustedFixedField::BssType => bss.bss_type = fidl_ieee80211::BssType::Independent,
+                TrustedFixedField::BeaconPeriod => bss.beacon_period ^= 1,
+                TrustedFixedField::CapabilityInfo => bss.capability_info ^= 1,
+                TrustedFixedField::Primary => bss.primary.number ^= 1,
+                TrustedFixedField::Bandwidth => {
+                    bss.bandwidth = fidl_ieee80211::ChannelBandwidth::Cbw40
+                }
+                TrustedFixedField::VhtSecondary80Channel => {
+                    bss.vht_secondary_80_channel.number ^= 1
+                }
+                TrustedFixedField::RssiDbm => bss.rssi_dbm ^= 1,
+                TrustedFixedField::SnrDb => bss.snr_db ^= 1,
+            }
+        }
+        TrustedScanCorruption::DuplicateSplitAggregate => {
+            let duplicate = {
+                let original = aggregates.first_mut().expect("test requires aggregate");
+                assert!(original.lineage.merger_input_indices.len() >= 2);
+                let split_index = original.lineage.merger_input_indices.remove(0);
+                original.lineage.occupied_predicate_evaluations =
+                    original.lineage.merger_input_indices.len()
+                        + original.lineage.dropped_input_indices.len()
+                        - 1;
+                TrustedScanAggregate {
+                    fixed_bss: original.fixed_bss.clone(),
+                    lineage: TrustedBssLineage {
+                        bssid: original.lineage.bssid,
+                        representative_index: split_index,
+                        merger_input_indices: vec![split_index],
+                        dropped_input_indices: vec![],
+                        occupied_predicate_evaluations: 0,
+                    },
+                }
+            };
+            aggregates.push(duplicate);
         }
     }
 }
 
