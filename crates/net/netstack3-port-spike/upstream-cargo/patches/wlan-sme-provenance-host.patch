+        #[cfg(not(target_os = "fuchsia"))]
+        if let Some(corruption) = state.terminal_corruption.take() {
+            corrupt_trusted_structure_for_test(&mut state.inputs, &mut aggregates, corruption);
+        }
+        // The generic SME treats this only as an untrusted structural decision.
