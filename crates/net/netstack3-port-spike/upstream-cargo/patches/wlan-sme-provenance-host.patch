+    /// Synchronous preflight-and-consume gateway. All structural checks consult
+    /// the scheduler's sole durable poison state before affine admission. A
+    /// rejection returns the exact `(ScanResult, P)` to its untrusted caller.
+    pub fn on_trusted_mlme_scan_result<P>(
+        &mut self,
+        msg: fidl_mlme::ScanResult,
+        provenance: P,
+        state: &mut TrustedScanState<P>,
+    ) -> Result<(), TrustedScanResultRejection<P>> {
+        let reject = |error, msg, provenance| TrustedScanResultRejection {
+            error,
+            msg,
+            provenance,
+        };
+        let Some(tag) = &mut self.trusted else {
+            return Err(reject(TrustedScanError::Inactive, msg, provenance));
+        };
+        if tag.poisoned {
+            return Err(reject(TrustedScanError::Failed, msg, provenance));
+        }
+        if state.in_flight.is_some() {
+            tag.poisoned = true;
+            return Err(reject(TrustedScanError::Failed, msg, provenance));
+        }
+        if self.scheduled_scan_receivers.contains_key(&msg.txn_id) {
+            tag.poisoned = true;
+            return Err(reject(TrustedScanError::Collision, msg, provenance));
+        }
+        if state.terminal_seen {
+            tag.poisoned = true;
+            return Err(reject(TrustedScanError::DuplicateOrLate, msg, provenance));
+        }
+        if state.inputs.len() >= TRUSTED_SCAN_CAPACITY {
+            tag.poisoned = true;
+            return Err(reject(TrustedScanError::Exhausted, msg, provenance));
+        }
+        let Some(next_encounter_index) = state.next_encounter_index.checked_add(1) else {
+            tag.poisoned = true;
+            return Err(reject(TrustedScanError::Exhausted, msg, provenance));
+        };
+        let current_matches = matches!(
+            &self.current,
+            ScanState::ScanningTrusted { generation, mlme_txn_id, .. }
+                if *generation == state.generation && *mlme_txn_id == msg.txn_id
+        );
+        if tag.txn_id != msg.txn_id
+            || tag.generation != state.generation
+            || state.txn_id != Some(msg.txn_id)
+            || !current_matches
+        {
+            tag.poisoned = true;
+            return Err(reject(TrustedScanError::Mismatch, msg, provenance));
+        }
+
+        let table_index = state.inputs.len();
+        let encounter_index = state.next_encounter_index;
+        // Set the durable admitted/in-progress guard before moving either affine
+        // value. The following Option store is non-allocating and proven empty.
+        tag.poisoned = true;
+        state.in_flight = Some(TrustedScanInput {
+            provenance,
+            original_result: msg,
+            table_index,
+            encounter_index,
+        });
+        #[cfg(not(target_os = "fuchsia"))]
+        if mem::take(&mut state.panic_after_result_retained) {
+            panic!("injected trusted scan result aggregation panic");
+        }
+        let bss = state
+            .in_flight
+            .as_ref()
+            .expect("installed after preflight")
+            .original_result
+            .bss
+            .clone();
+        let ScanState::ScanningTrusted { bss_map, .. } = &mut self.current else {
+            unreachable!("preflight proved trusted scan state");
+        };
+        maybe_insert_bss(
+            bss_map,
+            bss,
+            InsertMode::Trusted {
+                table_index,
+                encounter_index,
+            },
+        );
+        let input = state.in_flight.take().expect("installed after preflight");
+        state.inputs.push(input);
+        state.next_encounter_index = next_encounter_index;
+        tag.poisoned = false;
+        Ok(())
+    }
