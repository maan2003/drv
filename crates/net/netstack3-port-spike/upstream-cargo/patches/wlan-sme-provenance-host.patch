+fn destructure_trusted_bss_map(bss_map: BssMap) -> (BssMap, Vec<TrustedScanAggregate>) {
+    let mut ordinary = HashMap::with_capacity(bss_map.len());
+    let mut aggregates = Vec::with_capacity(bss_map.len());
+    for (bssid, (fixed_bss, merger, lineage)) in bss_map {
+        ordinary.insert(bssid, (fixed_bss.clone(), merger, None));
+        aggregates.push(TrustedScanAggregate {
+            fixed_bss,
+            lineage: lineage.expect("trusted entry has lineage"),
+        });
+    }
+    (ordinary, aggregates)
+}
