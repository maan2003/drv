+fn schedule_association_status_timeout_for_device(
+    beacon_period: zx::MonotonicDuration,
+    timer: &mut Timer<TimedEvent>,
+    connection_monitor_offload: bool,
+) -> StatusCheckTimeout {
+    if connection_monitor_offload {
+        StatusCheckTimeout { next_event: None }
+    } else {
+        schedule_association_status_timeout(beacon_period, timer)
+    }
