+#ifdef CONFIG_NETSTACK3_RUST
+bool ns3_nl_writable(void *p)
+{
+    struct sock *sk = p;
+    return atomic_read(&sk->sk_rmem_alloc) < READ_ONCE(sk->sk_rcvbuf) &&
+        !test_bit(NETLINK_S_CONGESTED, &nlk_sk(sk)->state);
+}
+void ns3_nl_loss(void *p) { netlink_overrun(p); }
+int ns3_nl_deliver(void *p, const u8 *bytes, size_t len, u32 group)
+{
+    struct sock *sk = p;
+    struct netlink_sock *nlk = nlk_sk(sk);
+    struct sk_buff *skb;
+    long timeo = 0;
+    int err;
+    bool subscribed;
+    if (group) {
+        netlink_lock_table();
+        subscribed = group <= nlk->ngroups && test_bit(group - 1, nlk->groups);
+        netlink_unlock_table();
+        if (!subscribed) return -ENOENT;
+    }
+    skb = netlink_alloc_large_skb(len, 0);
+    if (!skb) return -ENOMEM;
+    memcpy(skb_put(skb, len), bytes, len);
+    NETLINK_CB(skb).portid = 0;
+    NETLINK_CB(skb).dst_group = group;
+    if (sk_filter(sk, skb)) {
+        kfree_skb(skb);
+        return len;
+    }
+    sock_hold(sk);
+    /* Retain backpressure at the provider rather than flagging a dropped
+     * kernel multicast. This non-kernel sender argument prevents overrun. */
+    err = netlink_attachskb(sk, skb, &timeo, sk);
+    if (err) return err;
+    return netlink_sendskb(sk, skb);
+}
+#endif
+
+static __poll_t netlink_provider_poll(struct file *file, struct socket *sock,
+                                     poll_table *wait)
+{
+    __poll_t mask = datagram_poll(file, sock, wait);
+#ifdef CONFIG_NETSTACK3_RUST
+    void *owner = ns3_nl_owner(sock->sk);
+    if (owner) {
+        mask &= ~(EPOLLOUT | EPOLLWRNORM);
+        mask |= ns3_nl_poll(owner, file, wait);
+    }
+#endif
+    return mask;
+}
