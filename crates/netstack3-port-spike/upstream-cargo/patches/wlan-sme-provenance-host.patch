+    pub fn on_trusted_mlme_scan_result<P>(
+        &mut self,
+        msg: fidl_mlme::ScanResult,
+        provenance: P,
+        state: &mut TrustedScanState<P>,
+    ) -> Result<(), TrustedScanError> {
+        let Some(tag) = &mut self.trusted else {
+            state.failed = true;
+            state.input_provenance.push(provenance);
+            return Err(TrustedScanError::Inactive);
+        };
+        if self.scheduled_scan_receivers.contains_key(&msg.txn_id) {
+            tag.poisoned = true;
+            state.failed = true;
+            // Retain the affine carrier until its owner invalidates the session.
+            state.input_provenance.push(provenance);
+            return Err(TrustedScanError::Collision);
+        }
+        if tag.poisoned || state.failed {
+            tag.poisoned = true;
+            state.failed = true;
+            state.input_provenance.push(provenance);
+            return Err(TrustedScanError::Failed);
+        }
+        if state.terminal_seen {
+            tag.poisoned = true;
+            state.failed = true;
+            state.input_provenance.push(provenance);
+            return Err(TrustedScanError::DuplicateOrLate);
+        }
+        if tag.txn_id != msg.txn_id
+            || tag.generation != state.generation
+            || state.txn_id != Some(msg.txn_id)
+        {
+            tag.poisoned = true;
+            state.failed = true;
+            state.input_provenance.push(provenance);
+            return Err(TrustedScanError::Mismatch);
+        }
+        match &mut self.current {
+            ScanState::ScanningTrusted { generation, mlme_txn_id, bss_map }
+                if *generation == state.generation && *mlme_txn_id == msg.txn_id =>
+            {
+                // Stay poisoned across the panic-capable aggregation mutation.
+                // Only the successful return clears this in-progress guard.
+                tag.poisoned = true;
+                state.input_provenance.push(provenance);
+                #[cfg(not(target_os = "fuchsia"))]
+                if mem::take(&mut state.panic_after_result_retained) {
+                    panic!("injected trusted scan result aggregation panic");
+                }
+                maybe_insert_bss(bss_map, msg.bss);
+                tag.poisoned = false;
+                Ok(())
+            }
+            _ => {
+                tag.poisoned = true;
+                state.failed = true;
+                state.input_provenance.push(provenance);
+                Err(TrustedScanError::Mismatch)
+            }
+        }
+    }
+
+    pub fn on_trusted_mlme_scan_end<P>(
+        &mut self,
+        msg: fidl_mlme::ScanEnd,
+        state: &mut TrustedScanState<P>,
+        sme_inspect: &Arc<inspect::SmeTree>,
+    ) -> Result<TrustedScanTerminal<P>, TrustedScanError> {
+        if state.terminal_seen {
+            state.failed = true;
+            if let Some(tag) = &mut self.trusted {
+                tag.poisoned = true;
+            }
+            return Err(TrustedScanError::DuplicateOrLate);
+        }
+        state.terminal_seen = true;
+        let Some(tag) = self.trusted.as_mut() else {
+            state.failed = true;
+            return Err(TrustedScanError::Inactive);
+        };
+        let ordinary_empty = self.pending_discovery.is_empty()
+            && self.scheduled_scan_receivers.is_empty()
+            && self.trusted_quarantine.is_empty()
+            && self.trusted_scheduled_quarantine.is_empty()
+            && self.trusted_scheduled_senders.is_empty()
+            && self.trusted_value_quarantine.is_empty();
+        let current = mem::replace(&mut self.current, ScanState::NotScanning);
+        let ScanState::ScanningTrusted { generation, mlme_txn_id, bss_map } = current else {
+            if let ScanState::ScanningToDiscover { cmd, bss_map, .. } = current {
+                self.trusted_quarantine.push(cmd);
+                self.trusted_value_quarantine.push(bss_map);
+            }
+            tag.poisoned = true;
+            state.failed = true;
+            return Err(TrustedScanError::Mismatch);
+        };
+        let clean = !tag.poisoned
+            && !state.failed
+            && tag.txn_id == msg.txn_id
+            && tag.generation == state.generation
+            && state.txn_id == Some(msg.txn_id)
+            && mlme_txn_id == msg.txn_id
+            && generation == state.generation
+            && msg.code == fidl_mlme::ScanResultCode::Success
+            && ordinary_empty;
+        if !clean {
+            self.trusted_value_quarantine.push(bss_map);
+            tag.poisoned = true;
+            state.failed = true;
+            return Err(if tag.txn_id != msg.txn_id || tag.generation != state.generation {
+                TrustedScanError::Mismatch
+            } else {
+                TrustedScanError::Failed
+            });
+        }
+        let terminal = TrustedScanTerminal {
+            generation,
+            txn_id: mlme_txn_id,
+            bss_description_list: convert_bss_map(bss_map, None::<Ssid>, sme_inspect),
+            input_provenance: mem::take(&mut state.input_provenance),
+        };
+        self.trusted = None;
+        Ok(terminal)
+    }
