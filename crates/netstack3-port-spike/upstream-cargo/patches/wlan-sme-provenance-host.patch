+    pub fn start_trusted_scan<P>(
+        &mut self,
+        state: &mut TrustedScanState<P>,
+        scan_request: fidl_sme::ScanRequest,
+    ) -> Result<fidl_mlme::ScanRequest, TrustedScanError> {
+        if self.trusted.is_some()
+            || !matches!(self.current, ScanState::NotScanning)
+            || !self.pending_discovery.is_empty()
+            || !self.scheduled_scan_receivers.is_empty()
+            || !self.trusted_quarantine.is_empty()
+            || !self.trusted_scheduled_quarantine.is_empty()
+            || !self.trusted_scheduled_senders.is_empty()
+            || !self.trusted_value_quarantine.is_empty()
+            || !state.input_provenance.is_empty()
+            || state.txn_id.is_some()
+            || state.terminal_seen
+            || state.failed
+        {
+            if let Some(tag) = &mut self.trusted {
+                tag.poisoned = true;
+            }
+            state.failed = true;
+            return Err(TrustedScanError::Busy);
+        }
+        let txn_id = self.last_mlme_txn_id.checked_add(1).ok_or_else(|| {
+            state.failed = true;
+            TrustedScanError::Exhausted
+        })?;
+        self.last_mlme_txn_id = txn_id;
+        state.txn_id = Some(txn_id);
+        self.current = ScanState::ScanningTrusted {
+            generation: state.generation,
+            mlme_txn_id: txn_id,
+            bss_map: HashMap::new(),
+        };
+        self.trusted = Some(TrustedScanTag {
+            generation: state.generation,
+            txn_id,
+            poisoned: false,
+        });
+        Ok(new_scan_request(
+            txn_id,
+            scan_request,
+            vec![],
+            &self.device_info,
+            self.spectrum_management_support.clone(),
+        ))
+    }
