+/// Opaque, caller-owned affine state for one private trusted scan. Generic SME
+/// code carries `P` structurally but never interprets it or confers trust.
+pub struct TrustedScanState<P> {
+    generation: u64,
+    txn_id: Option<ScanTxnId>,
+    terminal_seen: bool,
+    failed: bool,
+    input_provenance: Vec<P>,
+    #[cfg(not(target_os = "fuchsia"))]
+    panic_after_result_retained: bool,
+}
+
+impl<P> TrustedScanState<P> {
+    pub fn new(generation: u64) -> Self {
+        Self {
+            generation,
+            txn_id: None,
+            terminal_seen: false,
+            failed: false,
+            input_provenance: Vec::new(),
+            #[cfg(not(target_os = "fuchsia"))]
+            panic_after_result_retained: false,
+        }
+    }
+
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+    pub fn txn_id(&self) -> Option<u64> {
+        self.txn_id
+    }
+    pub fn is_failed(&self) -> bool {
+        self.failed
+    }
+    #[cfg(not(target_os = "fuchsia"))]
+    pub fn inject_result_aggregation_panic_for_test(&mut self) {
+        self.panic_after_result_retained = true;
+    }
+}
+
+/// Opaque terminal returned to the co-located owner. Its affine carriers can
+/// only be inspected by reference, so owner validation never transfers them
+/// into an untrusted callback frame.
+pub struct TrustedScanTerminal<P> {
+    generation: u64,
+    txn_id: u64,
+    bss_description_list: Vec<BssDescription>,
+    input_provenance: Vec<P>,
+}
+
+impl<P> TrustedScanTerminal<P> {
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+    pub fn txn_id(&self) -> u64 {
+        self.txn_id
+    }
+    pub fn bss_description_list(&self) -> &[BssDescription] {
+        &self.bss_description_list
+    }
+    pub fn input_provenance(&self) -> impl ExactSizeIterator<Item = &P> {
+        self.input_provenance.iter()
+    }
+}
