+    /// Starts a host-private trusted scan on the actual scheduler. The caller
+    /// retains every affine provenance carrier in `state`; this method only
+    /// installs the scheduler routing tag and emits the real MLME request.
+    pub fn start_trusted_scan<P>(
+        &mut self,
+        state: &mut TrustedScanState<P>,
+        scan_request: fidl_sme::ScanRequest,
+    ) -> Result<u64, TrustedScanError> {
+        let request = self.scan_sched.start_trusted_scan(state, scan_request)?;
+        let txn_id = request.txn_id;
+        self.send_scan_request(Some(request));
+        Ok(txn_id)
+    }
+
+    pub fn on_trusted_mlme_scan_result<P>(
+        &mut self,
+        result: fidl_mlme::ScanResult,
+        provenance: P,
+        state: &mut TrustedScanState<P>,
+    ) -> Result<(), TrustedScanError> {
