+    Exhausted,
+    Inactive,
+    Collision,
+    Mismatch,
+    DuplicateOrLate,
+    Failed,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct TrustedScanTag {
+    generation: u64,
+    txn_id: ScanTxnId,
+    poisoned: bool,
+}
