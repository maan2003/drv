+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ScanResultIgnore {
+    MalformedFrame,
+    NonAdvertisement,
+    NoOngoingScan,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ScanResultDisposition<'a> {
+    Produced(&'a fidl_fuchsia_wlan_mlme::ScanResult),
+    Ignored(ScanResultIgnore),
+    ConversionDrop,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ScanResultObserverControl {
+    Continue,
+    Suppress,
+}
+
+/// In-process observation seam for the immutable terminal disposition produced
+/// by the client scanner. `P` is consumed structurally exactly once;
+/// implementing this trait does not confer any provenance or trust. A rejected
+/// produced result suppresses the ordinary MLME event. Transport failure is a
+/// later notification because the accepted observer already owns `P`.
+pub trait ScanResultObserver<P> {
+    fn observe(
+        &mut self,
+        disposition: &ScanResultDisposition<'_>,
+        provenance: P,
+    ) -> ScanResultObserverControl;
+
+    fn observe_transport_failure(&mut self) {}
+}
+
+impl<P> ScanResultObserver<P> for () {
+    fn observe(
+        &mut self,
+        _disposition: &ScanResultDisposition<'_>,
+        _provenance: P,
+    ) -> ScanResultObserverControl {
+        ScanResultObserverControl::Continue
+    }
+}
