+fn observed_receive_uses_exact_constructed_scan_result_and_ordinary_sink_is_unchanged() {
+    futures::executor::block_on(async {
+        fn scan_request() -> fidl_mlme::ScanRequest {
+            fidl_mlme::ScanRequest {
+                txn_id: 91,
+                scan_type: fidl_mlme::ScanTypes::Passive,
+                channel_list: vec![channel(6)],
+                ssid_list: vec![],
+                probe_delay: 0,
+                min_channel_time: 10,
+                max_channel_time: 20,
+            }
+        }
+
+        #[derive(Debug, PartialEq)]
+        enum Captured {
+            Produced(fidl_mlme::ScanResult),
+            Ignored(wlan_mlme::ScanResultIgnore),
+            ConversionDrop,
+        }
+        struct Capture(Option<(Captured, u64)>, usize);
+        impl wlan_mlme::ScanResultObserver<u64> for Capture {
+            fn observe(
+                &mut self,
+                disposition: &wlan_mlme::ScanResultDisposition<'_>,
+                provenance: u64,
+            ) -> wlan_mlme::ScanResultObserverControl {
+                self.1 += 1;
+                let captured = match disposition {
+                    wlan_mlme::ScanResultDisposition::Produced(result) => {
+                        Captured::Produced((*result).clone())
+                    }
+                    wlan_mlme::ScanResultDisposition::Ignored(reason) => {
+                        Captured::Ignored(*reason)
+                    }
+                    wlan_mlme::ScanResultDisposition::ConversionDrop => Captured::ConversionDrop,
+                };
+                self.0 = Some((captured, provenance));
+                wlan_mlme::ScanResultObserverControl::Continue
+            }
+        }
+
+        let (device, effects) = FakeDeviceOps::new();
+        let (timer, _) = wlan_mlme::common::timer::create_timer();
+        let mut observed = ClientMlme::new(Default::default(), device, timer)
+            .await
+            .unwrap();
+        observed
+            .handle_mlme_request(MlmeRequest::Scan(scan_request()))
+            .await
+            .unwrap();
+        let mut capture = Capture(None, 0);
+        observed
+            .handle_mac_frame_rx_observed(&peer_beacon(), rx_info(), 1.into(), 44, &mut capture)
+            .await;
+        assert_eq!(capture.1, 1);
+        assert_eq!(effects.lock().unwrap().events.len(), 1);
+        let emitted = effects.lock().unwrap().events.remove(0);
+        let fidl_mlme::MlmeEvent::OnScanResult { result: emitted } = emitted else {
+            panic!("expected scan result");
+        };
+        let (Captured::Produced(captured), provenance) = capture.0.take().unwrap()
+        else {
+            panic!("expected produced disposition");
+        };
+        assert_eq!(provenance, 44);
+        assert_eq!(captured, emitted);
+        let mut malformed_advertisement = peer_beacon();
+        malformed_advertisement.truncate(36);
+        malformed_advertisement.extend_from_slice(&[3, 0]);
+        observed
+            .handle_mac_frame_rx_observed(
+                &malformed_advertisement,
+                rx_info(),
+                6.into(),
+                48,
+                &mut capture,
+            )
+            .await;
+        assert_eq!(
+            capture.0,
+            Some((Captured::ConversionDrop, 48))
+        );
+        assert_eq!(capture.1, 2);
+
+        let (device, _) = FakeDeviceOps::new();
+        let (timer, _) = wlan_mlme::common::timer::create_timer();
+        let mut ignored = ClientMlme::new(Default::default(), device, timer).await.unwrap();
+        ignored
+            .handle_mac_frame_rx_observed(&peer_beacon(), rx_info(), 3.into(), 45, &mut capture)
+            .await;
+        assert_eq!(
+            capture.0,
+            Some((
+                Captured::Ignored(wlan_mlme::ScanResultIgnore::NoOngoingScan),
+                45,
+            ))
+        );
+        assert_eq!(capture.1, 3);
+        ignored
+            .handle_mac_frame_rx_observed(&[1], rx_info(), 4.into(), 46, &mut capture)
+            .await;
+        assert_eq!(
+            capture.0,
+            Some((
+                Captured::Ignored(wlan_mlme::ScanResultIgnore::MalformedFrame),
+                46,
+            ))
+        );
+        assert_eq!(capture.1, 4);
+        ignored
+            .handle_mac_frame_rx_observed(
+                &peer_assoc_success(),
+                rx_info(),
+                5.into(),
+                47,
+                &mut capture,
+            )
+            .await;
+        assert_eq!(
+            capture.0,
+            Some((
+                Captured::Ignored(wlan_mlme::ScanResultIgnore::NonAdvertisement),
+                47,
+            ))
+        );
+        assert_eq!(capture.1, 5);
+
+        let (device, effects) = FakeDeviceOps::new();
+        let (timer, _) = wlan_mlme::common::timer::create_timer();
+        let mut ordinary = ClientMlme::new(Default::default(), device, timer)
+            .await
+            .unwrap();
+        ordinary
+            .handle_mlme_request(MlmeRequest::Scan(scan_request()))
+            .await
+            .unwrap();
+        ordinary
+            .handle_mac_frame_rx(&peer_beacon(), rx_info(), 2.into())
+            .await;
+        assert_eq!(effects.lock().unwrap().events.len(), 1);
+        let ordinary = effects.lock().unwrap().events.remove(0);
+        let fidl_mlme::MlmeEvent::OnScanResult { result: ordinary } = ordinary else {
+            panic!("expected ordinary scan result");
+        };
+        assert_eq!(ordinary.txn_id, emitted.txn_id);
+        assert_eq!(ordinary.bss, emitted.bss);
+        // The host monotonic clock is not injected/frozen here, so the two
+        // separate executions intentionally do not assert timestamp equality.
+    });
+}
