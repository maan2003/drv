+#[test]
+fn sae_tx_renews_connect_timer_before_delayed_status77() {
+    tokio::runtime::Builder::new_current_thread()
+        .enable_time()
+        .build()
+        .unwrap()
+        .block_on(async {
+            let (device, effects) = FakeDeviceOps::new();
+            let (timer, mut timers) = wlan_mlme::common::timer::create_timer();
+            let mut mlme = ClientMlme::new(Default::default(), device, timer).await.unwrap();
+            let mut bss = wpa3_bss();
+            bss.beacon_period = 1;
+            mlme.handle_mlme_request(MlmeRequest::Connect(fidl_mlme::ConnectRequest {
+                selected_bss: bss,
+                connect_failure_timeout: 10,
+                auth_type: fidl_mlme::AuthenticationTypes::Sae,
+                sae_password: vec![],
+                wep_key: None,
+                security_ie: vec![],
+                owe_public_key: None,
+            }))
+            .await
+            .unwrap();
+            assert_eq!(mlme.sae_state_name(), "authenticating");
+            let original = timers.try_recv().expect("original connect timer");
+
+            effects.lock().unwrap().tx_delay = std::time::Duration::from_millis(20);
+            mlme.handle_mlme_request(MlmeRequest::SaeFrameTx(fidl_mlme::SaeFrame {
+                peer_sta_address: AP,
+                seq_num: 1,
+                status_code: fidl_ieee80211::StatusCode::Success,
+                sae_fields: vec![20, 0],
+            }))
+            .await
+            .unwrap();
+            assert_eq!(mlme.sae_state_name(), "authenticating");
+            let refreshed = timers.try_recv().expect("refreshed connect timer");
+
+            let stale: Vec<_> = wlan_mlme::common::timer::make_async_timed_event_stream(
+                futures::stream::iter([original]),
+            )
+            .collect()
+            .await;
+            assert!(stale.is_empty(), "initial connect timer must be canceled");
+
+            mlme.handle_mac_frame_rx(
+                &peer_auth_frame(&fidl_mlme::SaeFrame {
+                    peer_sta_address: CLIENT,
+                    seq_num: 1,
+                    status_code: fidl_ieee80211::StatusCode::from_primitive_allow_unknown(77),
+                    sae_fields: vec![20, 0],
+                }),
+                rx_info(),
+                9.into(),
+            )
+            .await;
+            assert_eq!(mlme.sae_state_name(), "authenticating");
+            assert!(matches!(
+                effects.lock().unwrap().events.last(),
+                Some(fidl_mlme::MlmeEvent::OnSaeFrameRx { .. })
+            ));
+
+            mlme.handle_timeout(refreshed.1.event).await;
+            assert_eq!(mlme.sae_state_name(), "joined");
+        });
+}
