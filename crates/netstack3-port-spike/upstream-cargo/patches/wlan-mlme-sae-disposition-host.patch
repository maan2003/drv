 use wlan_fidl_ext::{ResponderExt, SendResultExt};
 use wlan_trace as wtrace;
 
+pub(crate) fn sae_disposition(detail: std::fmt::Arguments<'_>) {
+    if std::env::var_os("DRV_SAE_DISPOSITION_TELEMETRY").is_some() {
+        println!("client_mlme_sae_disposition {detail}");
+    }
+}
+
+pub(crate) fn sae_public_group(seq_num: u16, fields: &[u8]) -> Option<u16> {
+    (seq_num == 1 && fields.len() >= 2)
+        .then(|| u16::from_le_bytes([fields[0], fields[1]]))
+}
+
+#[cfg(test)]
+mod sae_disposition_tests {
+    #[test]
+    fn public_group_reads_only_the_fixed_group_field() {
+        assert_eq!(super::sae_public_group(1, &[20, 0, 0xde, 0xad]), Some(20));
+        assert_eq!(super::sae_public_group(2, &[20, 0]), None);
+        assert_eq!(super::sae_public_group(1, &[20]), None);
+    }
+}
+
 trait WlanTxPacketExt {
     fn template(mac_frame: Vec<u8>) -> Self;
 }
