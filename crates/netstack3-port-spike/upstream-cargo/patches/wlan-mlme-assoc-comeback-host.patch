+const TIMEOUT_INTERVAL_IE_ID: u8 = 56;
+const TIMEOUT_INTERVAL_ASSOCIATION_COMEBACK: u8 = 3;
+
+fn association_response_ie_summary(elements: &[u8]) -> String {
+    let mut summary = Vec::new();
+    let mut offset = 0usize;
+    while let Some(header) = elements.get(offset..offset.saturating_add(2)) {
+        let len = usize::from(header[1]);
+        let Some(next) = offset.checked_add(2 + len) else { break };
+        if next > elements.len() {
+            summary.push(format!("{}:{}(truncated)", header[0], len));
+            break;
+        }
+        summary.push(format!("{}:{}", header[0], len));
+        offset = next;
+    }
+    if offset < elements.len() && elements.len().saturating_sub(offset) < 2 {
+        summary.push("truncated_header".to_string());
+    }
+    format!("ids={}", summary.join(","))
+}
+
+/// IEEE Timeout Interval IE: one-byte timeout type followed by a little-endian
+/// 32-bit interval in TUs. Linux only accepts type 3 for status 30; malformed,
+/// duplicate, wrong-type, and zero intervals follow the ordinary failure path.
+fn association_comeback_tu(elements: &[u8]) -> Option<u32> {
+    let mut offset = 0usize;
+    let mut comeback = None;
+    while offset < elements.len() {
+        let header = elements.get(offset..offset.checked_add(2)?)?;
+        let len = usize::from(header[1]);
+        let next = offset.checked_add(2 + len)?;
+        let body = elements.get(offset + 2..next)?;
+        if header[0] == TIMEOUT_INTERVAL_IE_ID {
+            if comeback.is_some()
+                || body.len() != 5
+                || body[0] != TIMEOUT_INTERVAL_ASSOCIATION_COMEBACK
+            {
+                return None;
+            }
+            let tu = u32::from_le_bytes(body[1..5].try_into().ok()?);
+            if tu == 0 {
+                return None;
+            }
+            comeback = Some(tu);
+        }
+        offset = next;
+    }
+    comeback
+}
