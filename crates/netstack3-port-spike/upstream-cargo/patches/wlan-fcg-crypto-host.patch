+int EC_wpa3_sae_hash_to_curve_p384(const EC_GROUP *group, EC_POINT *out,
+                                   const uint8_t *salt, size_t salt_len,
+                                   const uint8_t *ikm, size_t ikm_len) {
+  if (EC_GROUP_cmp(group, out->group, nullptr) != 0) {
+    OPENSSL_PUT_ERROR(EC, EC_R_INCOMPATIBLE_OBJECTS);
+    return 0;
+  }
+  if (EC_GROUP_get_curve_name(group) != NID_secp384r1) {
+    OPENSSL_PUT_ERROR(EC, EC_R_GROUP_MISMATCH);
+    return 0;
+  }
+
+  uint8_t pwd_seed[EVP_MAX_MD_SIZE];
+  size_t pwd_seed_len;
+  if (!HKDF_extract(pwd_seed, &pwd_seed_len, EVP_sha384(), ikm, ikm_len, salt,
+                    salt_len)) {
+    return 0;
+  }
+
+  uint8_t pwd_value[72];  // `len` for P-384 is 48 + 48 / 2.
+  auto label = StringAsBytes("SAE Hash to Element u1 P1");
+  if (!HKDF_expand(pwd_value, sizeof(pwd_value), EVP_sha384(), pwd_seed,
+                   pwd_seed_len, label.data(), label.size())) {
+    return 0;
+  }
+  EC_FELEM u1;
+  big_endian_reduce_to_felem(group, &u1, pwd_value);
+
+  label = StringAsBytes("SAE Hash to Element u2 P2");
+  if (!HKDF_expand(pwd_value, sizeof(pwd_value), EVP_sha384(), pwd_seed,
+                   pwd_seed_len, label.data(), label.size())) {
+    return 0;
+  }
+  EC_FELEM u2;
+  big_endian_reduce_to_felem(group, &u2, pwd_value);
+
+  // Z = -12, c2 = sqrt(12).
+  EC_FELEM Z, c2;
+  if (!felem_from_u8(group, &Z, 12) ||
+      !ec_felem_from_bytes(group, &c2, kP384Sqrt12, sizeof(kP384Sqrt12))) {
+    return 0;
+  }
+  ec_felem_neg(group, &Z, &Z);
+
+  return sswu_and_add(group, &Z, &c2, &out->raw, &u1, &u2);
+}
