#!/usr/bin/env bash
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)
manifest="$repo/nix/fuchsia-reference.json"
readarray -t metadata < <(python3 - "$manifest" <<'PY'
import json
import sys
with open(sys.argv[1]) as source:
    manifest = json.load(source)
print(manifest["commit"])
print(manifest["closure"])
PY
)
commit=${metadata[0]}
closure=${metadata[1]}
refroot=${DRV_FUCHSIA_REFERENCE_ROOT:-$repo/reference/fuchsia-$commit}

if [[ ! -e "$refroot" ]]; then
  DRV_FUCHSIA_REFERENCE_ROOT="$refroot" "$repo/scripts/fetch-fuchsia-reference"
fi
if [[ ! -f "$refroot/COMMIT" ]] || [[ $(cat "$refroot/COMMIT") != "$commit" ]] ||
   [[ ! -f "$refroot/.drv-source-closure" ]] ||
   [[ $(cat "$refroot/.drv-source-closure") != "$closure" ]] ||
   [[ ! -f "$refroot/src/lib/mundane/src/lib.rs" ]] ||
   [[ ! -f "$refroot/src/lib/fuchsia-sync/src/lib.rs" ]] ||
   [[ ! -f "$refroot/src/lib/fuchsia-async/src/lib.rs" ]] ||
   [[ ! -f "$refroot/sdk/lib/driver/runtime/rust/src/lib.rs" ]] ||
   [[ ! -f "$refroot/src/connectivity/wlan/lib/fcg-crypto/src/lib.rs" ]] ||
   [[ ! -f "$refroot/src/lib/trace/rust/src/lib.rs" ]] ||
   [[ ! -f "$refroot/src/lib/fidl/rust/fidl/src/lib.rs" ]] ||
   [[ ! -f "$refroot/sdk/rust/zx-status/src/lib.rs" ]] ||
   [[ ! -f "$refroot/third_party/boringssl/src/include/openssl/base.h" ]]; then
  printf 'incomplete or stale Fuchsia reference: %s\n' "$refroot" >&2
  printf 'materialize a fresh root with DRV_FUCHSIA_REFERENCE_ROOT=<new-path> %s\n' \
    "$repo/scripts/fetch-fuchsia-reference" >&2
  exit 2
fi

cp -R "$here/upstream-cargo/src" "$refroot/"
cp -R "$here/upstream-cargo/sdk" "$refroot/"
cp -R "$here/upstream-cargo/third_party" "$refroot/"
cp "$here/upstream-cargo/LICENSE.fuchsia" "$refroot/LICENSE"

patch_dir="$here/upstream-cargo/patches"
host_patches=(
  "$patch_dir/dhcp-client-core-host.patch"
  "$patch_dir/trust-dns-workspace.patch"
  "$patch_dir/wlan-common-host.patch"
  "$patch_dir/wlan-frame-writer-host.patch"
  "$patch_dir/wlan-fcg-crypto-host.patch"
  "$patch_dir/wlan-fidl-ext-host.patch"
  "$patch_dir/wlan-rsn-host.patch"
  "$patch_dir/wlan-sme-host.patch"
  "$patch_dir/wlan-sme-provenance-host.patch"
  "$patch_dir/wlancfg-selection-host.patch"
  "$patch_dir/wlan-trace-host.patch"
  "$patch_dir/wlan-timer-host.patch"
  "$patch_dir/wlan-mlme-host.patch"
  "$patch_dir/wlan-mlme-provenance-host.patch"
  "$patch_dir/wlan-mlme-sae-disposition-host.patch"
)
patch_set=$(cat "${host_patches[@]}" | sha256sum | cut -d' ' -f1)
patch_stamp="$refroot/.drv-host-patch-set"
if [[ -f $patch_stamp && $(cat "$patch_stamp") != "$patch_set" ]]; then
  printf 'host patch set changed for materialized reference: %s\n' "$refroot" >&2
  printf 'materialize a fresh DRV_FUCHSIA_REFERENCE_ROOT before applying it\n' >&2
  exit 2
fi

apply_host_patch() {
  local patch_file=$1 forward reverse
  if forward=$(patch --dry-run --fuzz=0 -d "$refroot" -p1 --forward < "$patch_file" 2>&1); then
    if [[ $forward =~ fuzz|offset ]]; then
      printf 'non-exact patch dry-run for %s:\n%s\n' "$patch_file" "$forward" >&2
      return 1
    fi
    forward=$(patch --fuzz=0 -d "$refroot" -p1 --forward < "$patch_file" 2>&1)
    if [[ $forward =~ fuzz|offset ]]; then
      printf 'non-exact patch application for %s:\n%s\n' "$patch_file" "$forward" >&2
      return 1
    fi
    return 0
  fi
  if reverse=$(patch --dry-run --fuzz=0 -d "$refroot" -p1 --reverse < "$patch_file" 2>&1); then
    if [[ $reverse =~ fuzz|offset ]]; then
      printf 'non-exact reverse patch proof for %s:\n%s\n' "$patch_file" "$reverse" >&2
      return 1
    fi
    return 0
  fi
  printf 'patch is neither exactly applicable nor exactly applied: %s\n' "$patch_file" >&2
  printf 'forward dry-run:\n%s\nreverse dry-run:\n%s\n' "$forward" "$reverse" >&2
  return 1
}

for patch_file in "${host_patches[@]}"; do
  apply_host_patch "$patch_file"
done
printf '%s\n' "$patch_set" > "$patch_stamp"

manifest="$refroot/src/connectivity/network/netstack3/Cargo.toml"
cargo check --locked --manifest-path "$manifest" -p netstack3_core
cargo check --locked --manifest-path "$manifest" -p netstack3-port-integration
cargo check --locked --manifest-path "$manifest" -p dhcp-protocol
cargo check --locked --manifest-path "$manifest" -p dhcp_client_core
cargo check --locked --manifest-path "$manifest" -p trust-dns-resolver --no-default-features --features testing
cargo check --locked --manifest-path "$manifest" -p wlan-common
cargo test --locked --manifest-path "$manifest" -p fuchsia-softmac-port
cargo test --locked --manifest-path "$manifest" -p wlan-mlme --test host-client-gate
cargo test --locked --manifest-path "$manifest" -p wlan-common --test host-timer
cargo test --locked --manifest-path "$manifest" -p wlan-frame-writer --lib
cargo test --locked --manifest-path "$manifest" -p zx-status --lib
cargo test --locked --manifest-path "$manifest" -p zx --lib
cargo test --locked --manifest-path "$manifest" -p fidl --lib
cargo test --locked --manifest-path "$manifest" -p fuchsia-inspect --lib
cargo test --locked --manifest-path "$manifest" -p fuchsia-inspect-contrib --lib
cargo test --locked --manifest-path "$manifest" -p wlan-fidl-ext --lib
cargo test --locked --manifest-path "$manifest" -p fidl-fuchsia-wlan-driver --lib
cargo test --locked --manifest-path "$manifest" -p fidl-fuchsia-wlan-internal --lib
cargo test --locked --manifest-path "$manifest" -p fidl-fuchsia-wlan-minstrel --lib
cargo test --locked --manifest-path "$manifest" -p fidl-fuchsia-wlan-mlme --lib
cargo test --locked --manifest-path "$manifest" -p fidl-fuchsia-wlan-softmac --lib
cargo test --locked --manifest-path "$manifest" -p fidl-fuchsia-wlan-sme --lib
cargo test --locked --manifest-path "$manifest" -p fidl-fuchsia-wlan-stats --lib
cargo test --locked --manifest-path "$manifest" -p fuchsia-trace --lib
cargo test --locked --manifest-path "$manifest" -p wlan-trace --lib
cargo test --locked --manifest-path "$manifest" -p eapol --lib
cargo test --locked --manifest-path "$manifest" -p mundane --lib hash::tests
cargo test --locked --manifest-path "$manifest" -p mundane --lib hmac::tests
cargo test --locked --manifest-path "$manifest" -p wlan-fcg-crypto --lib
cargo test --locked --manifest-path "$manifest" -p fuchsia-sync --lib
cargo test --locked --manifest-path "$manifest" -p wlan-rsn --lib
cargo check --locked --manifest-path "$manifest" -p wlan-sme
cargo test --locked --manifest-path "$manifest" -p wlan-sme --test host-client-policy
cargo test --locked --manifest-path "$manifest" -p wlancfg-selection --test host-selection
cargo check --locked --manifest-path "$manifest" -p netstack3_core --features testutils
cargo test --locked --manifest-path "$manifest" -p netstack3-port-integration --tests
