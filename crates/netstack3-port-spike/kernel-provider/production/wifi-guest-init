#!/bin/busybox sh
/bin/busybox --install -s /bin
set -eu
finish() {
    if test -n "${dns_pid-}"; then
        kill "$dns_pid" 2>/dev/null || true
        sleep 2
    fi
    if test -n "${driver-}"; then
        kill -TERM "$driver" 2>/dev/null || true
        wait "$driver" 2>/dev/null || true
    fi
    echo GUEST_WIFI_FAILURE
    cat /run/stack.log 2>/dev/null || true
    if test "$(cat /run/driver.safety 2>/dev/null)" = SAFE; then echo GUEST_MT_HARDWARE_SAFE; fi
    reboot -f
}
trap finish EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
zcat /proc/config.gz | grep -q '^# CONFIG_INET is not set$'
fw=/sys/firmware/qemu_fw_cfg/by_name
/bin/curl --version | head -1
/run/current-system/sw/bin/zstdcat /run/current-system/firmware/mediatek/WIFI_MT7961_patch_mcu_1_2_hdr.bin.zst | sha256sum
device=/sys/bus/pci/devices/0000:01:00.0
test "$(cat "$device/vendor")" = 0x14c3
test "$(cat "$device/device")" = 0x7961
test "$(ls "$device/iommu_group/devices" | wc -l)" = 1
echo vfio-pci > "$device/driver_override"
echo 0000:01:00.0 > /sys/bus/pci/drivers_probe
test -e /dev/iommu
vfio=$(ls /dev/vfio/devices/vfio*)
test -c "$vfio"
echo "GUEST_MT_IOMMU_GROUP=$(readlink "$device/iommu_group") cdev=$vfio"
printf 'SAFE\n' >/run/driver.safety
export DRV_PCI_BDF=0000:01:00.0
export DRV_IOMMU_GROUP=$(basename "$(readlink "$device/iommu_group")")
export DRV_VFIO_DEVICE="$vfio" DRV_LAB_SAFETY_STATE=/run/driver.safety
export DRV_ACTIVE_CLIENT=1
export DRV_SAE_BSSID=$(cat "$fw/opt/drv-bssid/raw")
export DRV_SAE_CHANNEL=149 DRV_SAE_SSID=ajay DRV_SAE_CLIENT_MAC=da:61:40:51:27:e8
export DRV_REGULATORY_SNAPSHOT_FD=4 DRV_REGULATORY_SNAPSHOT_LEN=$(wc -c < "$fw/opt/drv-regulatory/raw")
export DRV_REGULATORY_SOURCE_SHA256=2fb33ca0074db573e05ef7dd50bb45b63c0ff98b7e852e1105ebad536fae8e6b
export DRV_STACK_MAX_SECONDS=60 DRV_DAEMON_MAX_SECONDS=60
mkdir -m 700 /run/wlancfg-state
mount -t tmpfs -o mode=700 tmpfs /run/wlancfg-state
/bin/wlan-stack-kvm /bin/mt7921-passive-scan /bin/wlancfg-service /bin/netstack3-provider /run/wlancfg-state \
    4<"$fw/opt/drv-regulatory/raw" >/run/stack.log 2>&1 &
driver=$!
scan_ready=false
for i in $(seq 1 300); do
    scan_rc=0
    /bin/wlanctl scan >/run/scan.log 2>&1 || scan_rc=$?
    sed "s/^/WLANCTL_SCAN_RESULT rc=$scan_rc /" /run/scan.log
    if test "$scan_rc" -eq 0 &&
       grep -q '^ssid=ajay security=wpa3 ' /run/scan.log; then
        scan_ready=true
        break
    fi
    if ! kill -0 "$driver" 2>/dev/null; then break; fi
    sleep .1
done
$scan_ready
cat /run/scan.log
/bin/wlanctl connect ajay wpa3 <"$fw/opt/drv-credential/raw"
associated=false
network_ready=false
for i in $(seq 1 500); do
    if /bin/wlanctl status >/run/status.log 2>&1 &&
       grep -q '^association=connected .* ssid=ajay address=unavailable internet=unknown$' /run/status.log; then
        associated=true
    fi
    if grep -q 'provider_network_status=Bound' /run/stack.log; then
        network_ready=true
    fi
    if $associated && $network_ready; then break; fi
    if ! kill -0 "$driver" 2>/dev/null; then break; fi
    sleep .1
done
cat /run/status.log
$associated
$network_ready
echo PASS_WLANCTL_MT7921_ASSOCIATION
result=1
dhcp_dns=$(sed -n 's/.* dns=\[Some(\([^)]*\)).*/\1/p' /run/stack.log | head -1)
test -n "$dhcp_dns"
echo "GUEST_DHCP_DNS=$dhcp_dns"
rm -f /run/drv-resolver.sock
/bin/busybox tail -f /dev/null |
    /bin/drv-dns-service 3</etc/quad9.toml 4</etc/ssl/certs/ca-certificates.crt 2>&1 |
    /bin/busybox tee /run/dns.log &
dns_pipeline=$!
for i in $(seq 1 100); do
    if grep -q DNS_READY /run/dns.log; then break; fi
    if ! kill -0 "$driver" 2>/dev/null; then break; fi
    sleep .1
done
grep -q DNS_READY /run/dns.log
dns_pid=$(pidof drv-dns-service)
test -n "$dns_pid"
printf 'nameserver 127.0.0.1\nnameserver ::1\n' >/etc/resolv.conf
printf 'hosts: files drv\n' >/etc/nsswitch.conf
LD_LIBRARY_PATH=/lib /bin/dns-check
echo PASS_MT_GUEST_QUAD9_DNS
/bin/loopback-test
echo PASS_MT_GUEST_LIVE_WIFI_LOCALHOST
if LD_LIBRARY_PATH=/lib /bin/curl --noproxy '*' --http1.1 --fail --show-error --connect-timeout 5 --max-time 10 \
   https://example.com/ -o /run/example.html &&
   grep -q 'Example Domain' /run/example.html; then
    echo PASS_MT_GUEST_WIFI_DNS_TLS_HTTP
    if LD_LIBRARY_PATH=/lib /bin/curl --noproxy '*' --http1.1 --fail --show-error --connect-timeout 5 --max-time 20 \
       'https://speed.cloudflare.com/__down?bytes=1048576' -o /run/download &&
       test "$(wc -c </run/download)" = 1048576; then
        echo PASS_MT_GUEST_SECOND_ORIGIN_TLS_1MIB
        result=0
    fi
fi
kill "$dns_pid"
wait "$dns_pipeline" 2>/dev/null || true
unset dns_pid
# The launcher deadline is a fallback, not a post-acceptance soak. Request its
# existing orderly policy-close/driver-safe shutdown as soon as app gates finish.
kill -TERM "$driver" 2>/dev/null || true
set +e
wait "$driver"
driver_rc=$?
set -e
cat /run/stack.log
echo "GUEST_DRIVER_EXIT=$driver_rc safety=$(cat /run/driver.safety)"
test "$(cat /run/driver.safety)" = SAFE
echo GUEST_MT_HARDWARE_SAFE
test "$result" = 0
test "$driver_rc" = 0
echo PASS_MT_GUEST_INTERNET
trap - EXIT
reboot -f
