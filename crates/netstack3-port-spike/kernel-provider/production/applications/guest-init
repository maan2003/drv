#!/bin/busybox sh
set -eu
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/shm /run/applications /home/app /tmp /dev/pts
mount -t tmpfs -o mode=1777,size=256m tmpfs /dev/shm
mount -t devpts devpts /dev/pts
chmod 1777 /tmp
printf 'root:x:0:0:root:/root:/bin/sh\napp:x:1000:1000:app:/home/app:/bin/sh\n' >/etc/passwd
printf 'root:x:0:\napp:x:1000:\n' >/etc/group
# The image was assembled by an unprivileged build user. Do not let the app
# inherit ownership of executables, service configuration or shared libraries.
chown -R 0:0 /bin /lib /nix /etc
test ! -d /opt || chown -R 0:0 /opt
chown -R 1000:1000 /home/app /run/applications
printf 'hosts: files drv\n' >/etc/nsswitch.conf
printf 'nameserver 127.0.0.1\n' >/etc/resolv.conf
printf '127.0.0.1 localhost\n::1 localhost\n' >/etc/hosts
hostname drv-application-lab
export LD_LIBRARY_PATH=/lib
zcat /proc/config.gz | grep '^# CONFIG_INET is not set$'
/bin/sh -i 3<>/dev/vport0p2 0<&3 1>&3 2>&3 3<&- &
/bin/netstack3-virtio-lab --external-dns >/run/provider.log 2>&1 &
for i in $(seq 1 200); do
 grep -q provider_network_status=Bound /run/provider.log && break
 sleep .1
done
grep -q provider_network_status=Bound /run/provider.log
/bin/drv-dns-service 3</etc/quad9.toml 4</etc/ssl/certs/ca-certificates.crt 2>&1 | tee /run/dns.log &
sleep 2
grep -q DNS_READY /run/dns.log
su app -c '/bin/node /etc/applications/http-fixture.js' >/run/applications/node.log 2>&1 &
sleep 2
cat /run/applications/node.log
grep -q APP_HTTP_READY /run/applications/node.log
echo APP_GUEST_READY
while true; do sleep 60; done
