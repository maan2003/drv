From: Wi-Fi driver lab spike <noreply@localhost>
Subject: [PATCH] wifi: mt76: mt7921: optionally retain D0 across remove

This is a lab-only handoff aid for the exact MT7961 adapter used by the
userspace-driver spike.  The PCI core drops the probe-time runtime-PM
reference after ->remove returns, which puts this adapter into D3hot before
vfio can claim it.  Take an extra no-resume reference only after the native
driver has stopped DMA and IRQ handling, so the PCI core's final put leaves
the function in D0.

The reference is deliberately retained across the vfio handoff.  This is not
a production lifetime policy; enable it only for the guarded lab target with
mt7921e.keep_d0_on_remove=1.
---
 drivers/net/wireless/mediatek/mt76/mt7921/pci.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/pci.c b/drivers/net/wireless/mediatek/mt76/mt7921/pci.c
--- a/drivers/net/wireless/mediatek/mt76/mt7921/pci.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/pci.c
@@ -7,6 +7,7 @@
 #include <linux/module.h>
 #include <linux/pci.h>
 #include <linux/of.h>
+#include <linux/pm_runtime.h>
 
 #include "mt7921.h"
 #include "../mt76_connac2_mac.h"
@@ -34,5 +35,10 @@ module_param_named(disable_aspm, mt7921_disable_aspm, bool, 0644);
 MODULE_PARM_DESC(disable_aspm, "disable PCI ASPM support");
 
+static bool mt7921_keep_d0_on_remove;
+module_param_named(keep_d0_on_remove, mt7921_keep_d0_on_remove, bool, 0600);
+MODULE_PARM_DESC(keep_d0_on_remove,
+		 "spike-only: retain D0 across removal on the lab MT7961");
+
 static int mt7921e_init_reset(struct mt792x_dev *dev)
 {
 	return mt792x_wpdma_reset(dev, true);
@@ -411,6 +417,20 @@ static void mt7921_pci_remove(struct pci_dev *pdev)
 	devm_free_irq(&pdev->dev, pdev->irq, dev);
 	mt76_free_device(&dev->mt76);
 	pci_free_irq_vectors(pdev);
+
+	/*
+	 * Spike-only: mt7921e_unregister_device() has stopped DMA, NAPI,
+	 * tasklets and work, and the IRQ resources above are now gone.  Offset
+	 * the PCI core's post-remove runtime-PM put so this exact lab function
+	 * remains in D0 for vfio.  The reference intentionally survives the
+	 * handoff and is not suitable as a production power-management policy.
+	 */
+	if (mt7921_keep_d0_on_remove &&
+	    pdev->vendor == PCI_VENDOR_ID_MEDIATEK &&
+	    pdev->device == 0x7961 &&
+	    pdev->subsystem_vendor == 0x1a3b &&
+	    pdev->subsystem_device == 0x4680)
+		pm_runtime_get_noresume(&pdev->dev);
 }
 
 static int mt7921_pci_suspend(struct device *device)
-- 
