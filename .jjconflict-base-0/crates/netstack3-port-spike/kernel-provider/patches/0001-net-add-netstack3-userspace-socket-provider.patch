From: drv project <devnull@example.invalid>
Subject: [PATCH] net: add Netstack3 userspace socket provider

Add a built-in, protocol-agnostic socket proxy for userspace Netstack3. The
proxy preserves explicit 127/8 and ::1 sockets through hidden kernel sockets,
routes explicit remote TCP/UDP operations over the bounded NS3P v2 ABI, and
fails closed when the provider is absent. Wildcard bind selects provider
ownership; explicit private loopback remains in Linux.

Signed-off-by: drv project <devnull@example.invalid>
---
--- /dev/null
+++ b/include/net/netstack3_provider.h
--- /dev/null
+++ b/include/net/netstack3_provider.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _NET_NETSTACK3_PROVIDER_H
+#define _NET_NETSTACK3_PROVIDER_H
+
+#include <linux/net.h>
+
+#ifdef CONFIG_NETSTACK3_PROVIDER
+bool netstack3_provider_supported(int type, int protocol);
+int netstack3_provider_create(struct net *net, struct socket *sock,
+			      int family, int protocol);
+#else
+static inline bool netstack3_provider_supported(int type, int protocol)
+{
+	return false;
+}
+static inline int netstack3_provider_create(struct net *net, struct socket *sock,
+					    int family, int protocol)
+{
+	return -EAFNOSUPPORT;
+}
+#endif
+#endif
--- a/net/Kconfig
+++ b/net/Kconfig
@@ -81,6 +81,16 @@
 
 menu "Networking options"
 
+config NETSTACK3_PROVIDER
+	bool "Netstack3 userspace socket provider"
+	depends on INET
+	default n
+	help
+	  Route non-kernel IPv4/IPv6 TCP and UDP sockets through a bounded
+	  userspace provider while retaining Linux for private loopback.
+	  With this enabled, provider absence fails remote operations closed.
+
+
 source "net/packet/Kconfig"
 source "net/psp/Kconfig"
 source "net/unix/Kconfig"
--- a/net/Makefile
+++ b/net/Makefile
@@ -80,3 +80,5 @@
 obj-$(CONFIG_MCTP)		+= mctp/
 obj-$(CONFIG_NET_HANDSHAKE)	+= handshake/
 obj-$(CONFIG_NET_SHAPER)	+= shaper/
+
+obj-$(CONFIG_NETSTACK3_PROVIDER) += netstack3_provider.o
--- /dev/null
+++ b/net/netstack3_provider.c
@@ -0,0 +1,1081 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Protocol-agnostic AF_INET/AF_INET6 socket proxy for a userspace Netstack3
+ * provider.  Linux retains only private loopback; this file never parses an
+ * IP packet or implements transport state.
+ */
+#include <linux/completion.h>
+#include <linux/fs.h>
+#include <linux/list.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/net.h>
+#include <linux/poll.h>
+#include <linux/refcount.h>
+#include <linux/slab.h>
+#include <linux/uio.h>
+#include <linux/wait.h>
+#include <linux/unaligned.h>
+#include <net/ipv6.h>
+#include <net/net_namespace.h>
+#include <net/netstack3_provider.h>
+#include <net/sock.h>
+
+#define NS3_MAGIC 0x5033534eU /* "NS3P" as little endian u32 */
+#define NS3_VERSION 2
+#define NS3_HEADER_LEN 40
+#define NS3_MAX_PAYLOAD (64 * 1024)
+#define NS3_QUEUE_LIMIT 128
+
+#define NS3_REQUEST 1
+#define NS3_RESPONSE 2
+#define NS3_READINESS_EVENT 3
+
+#define NS3_OPEN_CLIENT 1
+#define NS3_CLOSE_CLIENT 2
+#define NS3_OPEN_SOCKET 3
+#define NS3_BIND 4
+#define NS3_CONNECT 5
+#define NS3_DISCONNECT 6
+#define NS3_LISTEN 7
+#define NS3_ACCEPT 8
+#define NS3_SENDMSG 9
+#define NS3_RECVMSG 10
+#define NS3_SHUTDOWN 11
+#define NS3_GETNAME 12
+#define NS3_GET_ERROR 13
+#define NS3_SET_OPTION 14
+#define NS3_GET_OPTION 15
+#define NS3_READINESS 16
+#define NS3_CLOSE 17
+#define NS3_READINESS_CHANGED 18
+
+struct ns3_header {
+	__le32 magic;
+	__le16 version;
+	__le16 type;
+	__le16 opcode;
+	__le16 reserved;
+	__le64 namespace_id;
+	__le64 client_id;
+	__le64 request_id;
+	__le32 payload_len;
+} __packed;
+
+struct ns3_request {
+	struct list_head queued;
+	struct list_head pending;
+	struct completion done;
+	u8 *frame;
+	size_t frame_len;
+	u8 *response;
+	size_t response_len;
+	int error;
+};
+
+enum ns3_backend { NS3_UNDECIDED, NS3_LOOPBACK, NS3_REMOTE };
+
+struct ns3_client {
+	refcount_t refs;
+	bool opened;
+};
+
+struct ns3_sock {
+	struct sock sk;
+	struct socket *inner;
+	enum ns3_backend backend;
+	int family;
+	int type;
+	int protocol;
+	u64 namespace_id;
+	u64 client_id;
+	struct ns3_client *client;
+	u64 handle;
+	u64 provider_generation;
+	__poll_t readiness;
+	u64 readiness_sequence;
+	u16 provider_readiness;
+	bool connecting;
+	struct list_head remote_node;
+};
+
+static DEFINE_MUTEX(ns3_lock);
+static LIST_HEAD(ns3_queue);
+static LIST_HEAD(ns3_pending);
+static LIST_HEAD(ns3_sockets);
+static DECLARE_WAIT_QUEUE_HEAD(ns3_provider_wait);
+static unsigned int ns3_queued;
+static bool ns3_active;
+static u64 ns3_generation;
+static atomic64_t ns3_next_request = ATOMIC64_INIT(0);
+static atomic64_t ns3_next_client = ATOMIC64_INIT(0);
+
+static inline struct ns3_sock *ns3_sk(struct socket *sock)
+{
+	return container_of(sock->sk, struct ns3_sock, sk);
+}
+
+static int ns3_error(u8 code)
+{
+	switch (code) {
+	case 2: case 18: return -ENOBUFS;
+	case 3: return -EBADF;
+	case 4: case 5: case 8: return -EINVAL;
+	case 6: return -EADDRINUSE;
+	case 7: return -EAGAIN;
+	case 9: return -EMSGSIZE;
+	case 10: return -ENETUNREACH;
+	case 11: return -EHOSTUNREACH;
+	case 12: return -ECONNREFUSED;
+	case 13: return -EINPROGRESS;
+	case 14: return -EISCONN;
+	case 15: return -ETIMEDOUT;
+	case 16: return -EACCES;
+	case 17: return -EOPNOTSUPP;
+	default: return -EPROTO;
+	}
+}
+
+static bool ns3_valid_opcode(u16 opcode)
+{
+	return opcode >= NS3_OPEN_CLIENT && opcode <= NS3_READINESS_CHANGED;
+}
+
+static bool ns3_header_valid(const struct ns3_header *h, size_t len)
+{
+	u32 payload = le32_to_cpu(h->payload_len);
+
+	return len >= NS3_HEADER_LEN && h->magic == cpu_to_le32(NS3_MAGIC) &&
+		le16_to_cpu(h->version) == NS3_VERSION && !h->reserved &&
+		ns3_valid_opcode(le16_to_cpu(h->opcode)) &&
+		payload <= NS3_MAX_PAYLOAD && len == NS3_HEADER_LEN + payload;
+}
+
+static int ns3_call(struct ns3_sock *nsk, u16 opcode, const void *payload,
+		    u32 payload_len, u8 **response, size_t *response_len)
+{
+	struct ns3_request *req;
+	struct ns3_header *h;
+	int ret;
+
+	if (payload_len > NS3_MAX_PAYLOAD)
+		return -EMSGSIZE;
+	req = kzalloc(sizeof(*req), GFP_KERNEL);
+	if (!req)
+		return -ENOMEM;
+	req->frame_len = NS3_HEADER_LEN + payload_len;
+	req->frame = kmalloc(req->frame_len, GFP_KERNEL);
+	if (!req->frame) {
+		kfree(req);
+		return -ENOMEM;
+	}
+	INIT_LIST_HEAD(&req->queued);
+	INIT_LIST_HEAD(&req->pending);
+	init_completion(&req->done);
+	h = (struct ns3_header *)req->frame;
+	*h = (struct ns3_header) {
+		.magic = cpu_to_le32(NS3_MAGIC), .version = cpu_to_le16(NS3_VERSION),
+		.type = cpu_to_le16(NS3_REQUEST), .opcode = cpu_to_le16(opcode),
+		.namespace_id = cpu_to_le64(nsk->namespace_id),
+		.client_id = cpu_to_le64(nsk->client_id),
+		.request_id = cpu_to_le64(atomic64_inc_return(&ns3_next_request)),
+		.payload_len = cpu_to_le32(payload_len),
+	};
+	memcpy(req->frame + NS3_HEADER_LEN, payload, payload_len);
+
+	mutex_lock(&ns3_lock);
+	if (!ns3_active || (nsk->provider_generation &&
+	    nsk->provider_generation != ns3_generation)) {
+		ret = -ENETDOWN;
+		goto unlock_free;
+	}
+	if (ns3_queued >= NS3_QUEUE_LIMIT) {
+		ret = -EAGAIN;
+		goto unlock_free;
+	}
+	list_add_tail(&req->queued, &ns3_queue);
+	list_add_tail(&req->pending, &ns3_pending);
+	ns3_queued++;
+	mutex_unlock(&ns3_lock);
+	wake_up_interruptible(&ns3_provider_wait);
+
+	ret = wait_for_completion_interruptible(&req->done);
+	mutex_lock(&ns3_lock);
+	if (!list_empty(&req->queued)) {
+		list_del_init(&req->queued);
+		ns3_queued--;
+	}
+	if (!list_empty(&req->pending))
+		list_del_init(&req->pending);
+	mutex_unlock(&ns3_lock);
+	if (ret)
+		goto free;
+	if (req->error) {
+		ret = req->error;
+		goto free;
+	}
+	if (req->response_len < 1) {
+		ret = -EPROTO;
+		goto free;
+	}
+	if (req->response[0]) {
+		ret = req->response_len == 2 ? ns3_error(req->response[1]) : -EPROTO;
+		goto free;
+	}
+	*response_len = req->response_len - 1;
+	*response = req->response;
+	memmove(*response, *response + 1, *response_len);
+	req->response = NULL;
+	ret = 0;
+free:
+	kfree(req->response);
+	kfree(req->frame);
+	kfree(req);
+	return ret;
+unlock_free:
+	mutex_unlock(&ns3_lock);
+	goto free;
+}
+
+static int ns3_remote_open(struct ns3_sock *nsk)
+{
+	u8 socket[2] = { nsk->type == SOCK_DGRAM ? 1 : 2,
+			 nsk->family == AF_INET ? 4 : 6 };
+	__le32 quota = cpu_to_le32(256);
+	u8 *response = NULL;
+	size_t len = 0;
+	int ret;
+
+	mutex_lock(&ns3_lock);
+	if (!ns3_active) {
+		mutex_unlock(&ns3_lock);
+		return -ENETDOWN;
+	}
+	nsk->provider_generation = ns3_generation;
+	mutex_unlock(&ns3_lock);
+	if (!nsk->client->opened) {
+		ret = ns3_call(nsk, NS3_OPEN_CLIENT, &quota, sizeof(quota),
+			       &response, &len);
+		kfree(response);
+		if (ret || len)
+			return ret ?: -EPROTO;
+		nsk->client->opened = true;
+	}
+	ret = ns3_call(nsk, NS3_OPEN_SOCKET, socket, sizeof(socket), &response, &len);
+	if (ret)
+		return ret;
+	if (len != sizeof(__le64)) {
+		kfree(response);
+		return -EPROTO;
+	}
+	nsk->handle = get_unaligned_le64(response);
+	kfree(response);
+	nsk->backend = NS3_REMOTE;
+	mutex_lock(&ns3_lock);
+	list_add_tail(&nsk->remote_node, &ns3_sockets);
+	mutex_unlock(&ns3_lock);
+	return 0;
+}
+
+static bool ns3_is_loopback(const struct sockaddr *addr, int len)
+{
+	if (addr->sa_family == AF_INET && len >= sizeof(struct sockaddr_in)) {
+		const struct sockaddr_in *sin = (const void *)addr;
+		return (be32_to_cpu(sin->sin_addr.s_addr) >> 24) == 127;
+	}
+	if (addr->sa_family == AF_INET6 && len >= sizeof(struct sockaddr_in6)) {
+		const struct sockaddr_in6 *sin6 = (const void *)addr;
+		return ipv6_addr_loopback(&sin6->sin6_addr);
+	}
+	return false;
+}
+
+static int ns3_select(struct socket *sock, const struct sockaddr *addr, int len)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+	int ret;
+
+	if (nsk->backend != NS3_UNDECIDED)
+		return 0;
+	if (!ns3_is_loopback(addr, len))
+		return ns3_remote_open(nsk);
+	ret = sock_create_kern(sock_net(sock->sk), nsk->family, nsk->type,
+			       nsk->protocol, &nsk->inner);
+	if (!ret)
+		nsk->backend = NS3_LOOPBACK;
+	return ret;
+}
+
+static int ns3_encode_addr(u8 *out, const struct sockaddr *addr, int len,
+			   bool optional)
+{
+	if (optional &&
+	    ((addr->sa_family == AF_INET && len >= sizeof(struct sockaddr_in) &&
+	      !((const struct sockaddr_in *)addr)->sin_addr.s_addr) ||
+	     (addr->sa_family == AF_INET6 && len >= sizeof(struct sockaddr_in6) &&
+	      ipv6_addr_any(&((const struct sockaddr_in6 *)addr)->sin6_addr)))) {
+		out[0] = 0;
+		return 1;
+	}
+	if (addr->sa_family == AF_INET && len >= sizeof(struct sockaddr_in)) {
+		const struct sockaddr_in *sin = (const void *)addr;
+		out[0] = 4;
+		memcpy(out + 1, &sin->sin_addr, 4);
+		put_unaligned_le16(be16_to_cpu(sin->sin_port), out + 5);
+		return 7;
+	}
+	if (addr->sa_family == AF_INET6 && len >= sizeof(struct sockaddr_in6)) {
+		const struct sockaddr_in6 *sin6 = (const void *)addr;
+		out[0] = 6;
+		memcpy(out + 1, &sin6->sin6_addr, 16);
+		put_unaligned_le16(be16_to_cpu(sin6->sin6_port), out + 17);
+		return 19;
+	}
+	return -EINVAL;
+}
+
+static int ns3_decode_addr(const u8 *in, size_t len, struct sockaddr *addr)
+{
+	if (len >= 7 && in[0] == 4) {
+		struct sockaddr_in *sin = (void *)addr;
+		memset(sin, 0, sizeof(*sin));
+		sin->sin_family = AF_INET;
+		memcpy(&sin->sin_addr, in + 1, 4);
+		sin->sin_port = cpu_to_be16(get_unaligned_le16(in + 5));
+		return 7;
+	}
+	if (len >= 19 && in[0] == 6) {
+		struct sockaddr_in6 *sin6 = (void *)addr;
+		memset(sin6, 0, sizeof(*sin6));
+		sin6->sin6_family = AF_INET6;
+		memcpy(&sin6->sin6_addr, in + 1, 16);
+		sin6->sin6_port = cpu_to_be16(get_unaligned_le16(in + 17));
+		return 19;
+	}
+	return -EPROTO;
+}
+
+static int ns3_bind(struct socket *sock, struct sockaddr *addr, int len)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+	u8 payload[8 + 19];
+	u8 *response = NULL;
+	size_t response_len = 0;
+	int n, ret;
+
+	/*
+	 * A wildcard bind chooses remote provider ownership. Explicit loopback
+	 * addresses still choose the private Linux backend, but one descriptor
+	 * cannot listen on both independently implemented stacks.
+	 */
+
+	ret = ns3_select(sock, addr, len);
+	if (ret)
+		return ret;
+	if (nsk->backend == NS3_LOOPBACK)
+		return nsk->inner->ops->bind(nsk->inner, addr, len);
+	put_unaligned_le64(nsk->handle, payload);
+	n = ns3_encode_addr(payload + 8, addr, len, true);
+	if (n < 0)
+		return n;
+	if (n == 1) {
+		u16 port = addr->sa_family == AF_INET ?
+			be16_to_cpu(((const struct sockaddr_in *)addr)->sin_port) :
+			be16_to_cpu(((const struct sockaddr_in6 *)addr)->sin6_port);
+		put_unaligned_le16(port, payload + 9);
+		n += 2;
+	}
+	ret = ns3_call(nsk, NS3_BIND,
+		       payload, 8 + n, &response, &response_len);
+	if (!ret && response_len != 7 && response_len != 19)
+		ret = -EPROTO;
+	kfree(response);
+	return ret;
+}
+
+static int ns3_get_error(struct ns3_sock *nsk)
+{
+	u8 payload[8], *response = NULL;
+	size_t response_len = 0;
+	int ret;
+
+	put_unaligned_le64(nsk->handle, payload);
+	ret = ns3_call(nsk, NS3_GET_ERROR, payload, sizeof(payload),
+		       &response, &response_len);
+	if (!ret)
+		ret = response_len == 1 && response[0] ?
+			ns3_error(response[0]) : response_len == 1 ? 0 : -EPROTO;
+	kfree(response);
+	return ret;
+}
+
+static int ns3_connect(struct socket *sock, struct sockaddr *addr, int len, int flags)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+	u8 payload[8 + 19];
+	u8 *response = NULL;
+	size_t response_len = 0;
+	int n, ret;
+	u64 readiness_sequence;
+
+	ret = ns3_select(sock, addr, len);
+	if (ret)
+		return ret;
+	if (nsk->backend == NS3_LOOPBACK)
+		return nsk->inner->ops->connect(nsk->inner, addr, len, flags);
+	put_unaligned_le64(nsk->handle, payload);
+	n = ns3_encode_addr(payload + 8, addr, len, false);
+	if (n < 0)
+		return n;
+	readiness_sequence = READ_ONCE(nsk->readiness_sequence);
+	if (nsk->type == SOCK_STREAM)
+		WRITE_ONCE(nsk->connecting, true);
+	ret = ns3_call(nsk, NS3_CONNECT,
+		       payload, 8 + n, &response, &response_len);
+	kfree(response);
+	if (!ret || ret != -EINPROGRESS) {
+		WRITE_ONCE(nsk->connecting, false);
+		return ret ?: (response_len ? -EPROTO : 0);
+	}
+	if (flags & O_NONBLOCK)
+		return ret;
+	ret = wait_event_interruptible(*sk_sleep(&nsk->sk),
+		(READ_ONCE(nsk->readiness_sequence) != readiness_sequence &&
+		 READ_ONCE(nsk->provider_readiness) & 0xc0) ||
+		!READ_ONCE(ns3_active) ||
+		READ_ONCE(nsk->provider_generation) != READ_ONCE(ns3_generation));
+	if (ret)
+		return ret;
+	if (!READ_ONCE(ns3_active) ||
+	    READ_ONCE(nsk->provider_generation) != READ_ONCE(ns3_generation))
+		return -ENETDOWN;
+	WRITE_ONCE(nsk->connecting, false);
+	return READ_ONCE(nsk->provider_readiness) & 0x80 ?
+		ns3_get_error(nsk) : 0;
+}
+
+static int ns3_listen(struct socket *sock, int backlog)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+	u8 payload[12];
+	u8 *response = NULL;
+	size_t response_len = 0;
+	int ret;
+
+	if (nsk->type != SOCK_STREAM)
+		return -EOPNOTSUPP;
+	if (nsk->backend == NS3_UNDECIDED && (ret = ns3_remote_open(nsk)))
+		return ret;
+	if (nsk->backend == NS3_LOOPBACK)
+		return nsk->inner->ops->listen(nsk->inner, backlog);
+	put_unaligned_le64(nsk->handle, payload);
+	put_unaligned_le32(backlog, payload + 8);
+	ret = ns3_call(nsk, NS3_LISTEN, payload, sizeof(payload),
+		       &response, &response_len);
+	if (!ret && response_len != 7 && response_len != 19)
+		ret = -EPROTO;
+	kfree(response);
+	return ret;
+}
+
+static int ns3_init_socket(struct net *net, struct socket *sock, int family,
+			   int type, int protocol, u64 client_id,
+			   struct ns3_client *client);
+
+static int ns3_accept(struct socket *sock, struct socket *newsock,
+		      struct proto_accept_arg *arg)
+{
+	struct ns3_sock *nsk = ns3_sk(sock), *newnsk;
+	struct socket *inner = NULL;
+	u8 payload[8], *response = NULL;
+	size_t response_len = 0;
+	int ret;
+
+	if (nsk->backend == NS3_LOOPBACK) {
+		ret = sock_create_lite(nsk->family, nsk->type, nsk->protocol, &inner);
+		if (ret)
+			return ret;
+		ret = nsk->inner->ops->accept(nsk->inner, inner, arg);
+		if (ret) {
+			sock_release(inner);
+			return ret;
+		}
+		ret = ns3_init_socket(sock_net(sock->sk), newsock, nsk->family,
+				      nsk->type, nsk->protocol, nsk->client_id,
+				      nsk->client);
+		if (ret) {
+			sock_release(inner);
+			return ret;
+		}
+		newnsk = ns3_sk(newsock);
+		newnsk->inner = inner;
+		newnsk->backend = NS3_LOOPBACK;
+		newsock->state = SS_CONNECTED;
+		return 0;
+	}
+	if (nsk->backend != NS3_REMOTE)
+		return -EINVAL;
+	put_unaligned_le64(nsk->handle, payload);
+	ret = ns3_call(nsk, NS3_ACCEPT, payload, sizeof(payload),
+		       &response, &response_len);
+	if (ret)
+		return ret;
+	/* V2 returns handle followed by local and peer addresses. */
+	if (response_len < sizeof(__le64) + 14) {
+		kfree(response);
+		return -EPROTO;
+	}
+	ret = ns3_init_socket(sock_net(sock->sk), newsock, nsk->family,
+			      nsk->type, nsk->protocol, nsk->client_id,
+			      nsk->client);
+	if (ret) {
+		kfree(response);
+		return ret;
+	}
+	newnsk = ns3_sk(newsock);
+	newnsk->backend = NS3_REMOTE;
+	newnsk->provider_generation = nsk->provider_generation;
+	newnsk->handle = le64_to_cpup((__le64 *)response);
+	kfree(response);
+	mutex_lock(&ns3_lock);
+	list_add_tail(&newnsk->remote_node, &ns3_sockets);
+	mutex_unlock(&ns3_lock);
+	newsock->state = SS_CONNECTED;
+	return 0;
+}
+
+static int ns3_sendmsg(struct socket *sock, struct msghdr *msg, size_t len)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+	u8 *payload, *response = NULL;
+	size_t prefix = 13, response_len = 0;
+	int addr_len, ret;
+
+	if (msg->msg_name) {
+		ret = ns3_select(sock, msg->msg_name, msg->msg_namelen);
+		if (ret)
+			return ret;
+	}
+	if (nsk->backend == NS3_LOOPBACK)
+		return nsk->inner->ops->sendmsg(nsk->inner, msg, len);
+	if (nsk->backend == NS3_UNDECIDED)
+		return -ENOTCONN;
+	if (len > NS3_MAX_PAYLOAD - 31)
+		return -EMSGSIZE;
+	if (nsk->type == SOCK_DGRAM && msg->msg_name) {
+		addr_len = ns3_encode_addr((u8[19]){}, msg->msg_name,
+					   msg->msg_namelen, false);
+		if (addr_len < 0)
+			return addr_len;
+		prefix = 12 + addr_len;
+	}
+	payload = kmalloc(prefix + len, GFP_KERNEL);
+	if (!payload)
+		return -ENOMEM;
+	put_unaligned_le64(nsk->handle, payload);
+	put_unaligned_le32(msg->msg_flags, payload + 8);
+	if (nsk->type == SOCK_DGRAM && msg->msg_name)
+		ns3_encode_addr(payload + 12, msg->msg_name, msg->msg_namelen, false);
+	else
+		payload[12] = 0;
+	if (!copy_from_iter_full(payload + prefix, len, &msg->msg_iter)) {
+		kfree(payload);
+		return -EFAULT;
+	}
+	ret = ns3_call(nsk, NS3_SENDMSG, payload, prefix + len,
+		       &response, &response_len);
+	kfree(payload);
+	if (!ret)
+		ret = response_len == sizeof(__le32) ?
+			get_unaligned_le32(response) : -EPROTO;
+	kfree(response);
+	return ret;
+}
+
+static int ns3_recvmsg(struct socket *sock, struct msghdr *msg, size_t len,
+		       int flags)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+	u8 payload[16], *response = NULL, *data;
+	size_t response_len = 0, copied, data_len, addr_len;
+	int ret;
+
+	if (nsk->backend == NS3_LOOPBACK)
+		return nsk->inner->ops->recvmsg(nsk->inner, msg, len, flags);
+	if (nsk->backend != NS3_REMOTE)
+		return -ENOTCONN;
+	put_unaligned_le64(nsk->handle, payload);
+	put_unaligned_le32(min_t(size_t, len, NS3_MAX_PAYLOAD), payload + 8);
+	put_unaligned_le32(flags, payload + 12);
+	ret = ns3_call(nsk, NS3_RECVMSG, payload, sizeof(payload),
+		       &response, &response_len);
+	if (ret)
+		return ret;
+	if (response_len < 10) {
+		ret = -EPROTO;
+		goto out;
+	}
+	msg->msg_flags = get_unaligned_le32(response + 1);
+	if (response[9] == 0)
+		addr_len = 1;
+	else if (response[9] == 4)
+		addr_len = 7;
+	else if (response[9] == 6)
+		addr_len = 19;
+	else {
+		ret = -EPROTO;
+		goto out;
+	}
+	if (response_len < 9 + addr_len) {
+		ret = -EPROTO;
+		goto out;
+	}
+	if (response[9] && msg->msg_name) {
+		ret = ns3_decode_addr(response + 9, response_len - 9, msg->msg_name);
+		if (ret < 0)
+			goto out;
+		msg->msg_namelen = response[9] == 4 ?
+			sizeof(struct sockaddr_in) : sizeof(struct sockaddr_in6);
+	}
+	data = response + 9 + addr_len;
+	data_len = response_len - 9 - addr_len;
+	copied = min(len, data_len);
+	if (!copy_to_iter_full(data, copied, &msg->msg_iter))
+		ret = -EFAULT;
+	else {
+		if (copied < get_unaligned_le32(response + 5))
+			msg->msg_flags |= MSG_TRUNC;
+		ret = copied;
+	}
+out:
+	kfree(response);
+	return ret;
+}
+
+static int ns3_shutdown(struct socket *sock, int how)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+	u8 payload[9], *response = NULL;
+	size_t response_len = 0;
+	int ret;
+
+	if (nsk->backend == NS3_LOOPBACK)
+		return nsk->inner->ops->shutdown(nsk->inner, how);
+	if (nsk->backend != NS3_REMOTE || nsk->type != SOCK_STREAM)
+		return -ENOTCONN;
+	put_unaligned_le64(nsk->handle, payload);
+	payload[8] = how == SHUT_RD ? 1 : how == SHUT_WR ? 2 : 3;
+	ret = ns3_call(nsk, NS3_SHUTDOWN, payload, sizeof(payload),
+		       &response, &response_len);
+	kfree(response);
+	return ret ?: (response_len ? -EPROTO : 0);
+}
+
+static __poll_t ns3_poll(struct file *file, struct socket *sock, poll_table *wait)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+	__poll_t mask;
+
+	if (nsk->backend == NS3_LOOPBACK)
+		return nsk->inner->ops->poll(file, nsk->inner, wait);
+	poll_wait(file, sk_sleep(sock->sk), wait);
+	mutex_lock(&ns3_lock);
+	mask = ns3_active && nsk->provider_generation == ns3_generation ?
+		nsk->readiness : EPOLLERR | EPOLLHUP;
+	if (READ_ONCE(nsk->connecting))
+		mask &= ~(EPOLLOUT | EPOLLWRNORM);
+	mutex_unlock(&ns3_lock);
+	return mask;
+}
+
+static int ns3_getname(struct socket *sock, struct sockaddr *addr, int peer)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+	u8 payload[9], *response = NULL;
+	size_t response_len = 0;
+	int ret;
+
+	if (nsk->backend == NS3_LOOPBACK)
+		return nsk->inner->ops->getname(nsk->inner, addr, peer);
+	if (nsk->backend != NS3_REMOTE)
+		return -ENOTCONN;
+	put_unaligned_le64(nsk->handle, payload);
+	payload[8] = peer ? 2 : 1;
+	ret = ns3_call(nsk, NS3_GETNAME, payload, sizeof(payload),
+		       &response, &response_len);
+	if (!ret)
+		ret = ns3_decode_addr(response, response_len, addr);
+	kfree(response);
+	return ret < 0 ? ret : addr->sa_family == AF_INET ?
+		sizeof(struct sockaddr_in) : sizeof(struct sockaddr_in6);
+}
+
+static int ns3_setsockopt(struct socket *sock, int level, int optname,
+			  sockptr_t optval, unsigned int optlen)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+
+	if (nsk->backend == NS3_LOOPBACK)
+		return nsk->inner->ops->setsockopt(nsk->inner, level, optname,
+					    optval, optlen);
+	return -EOPNOTSUPP;
+}
+
+static int ns3_getsockopt(struct socket *sock, int level, int optname,
+			  char __user *optval, int __user *optlen)
+{
+	struct ns3_sock *nsk = ns3_sk(sock);
+	u8 payload[8], *response = NULL;
+	size_t response_len = 0;
+	int len, value, ret;
+
+	if (nsk->backend == NS3_LOOPBACK)
+		return nsk->inner->ops->getsockopt(nsk->inner, level, optname,
+					    optval, optlen);
+	if (nsk->backend != NS3_REMOTE || level != SOL_SOCKET || optname != SO_ERROR)
+		return -EOPNOTSUPP;
+	put_unaligned_le64(nsk->handle, payload);
+	ret = ns3_call(nsk, NS3_GET_ERROR, payload, sizeof(payload),
+		       &response, &response_len);
+	if (ret)
+		return ret;
+	if (response_len != 1) {
+		kfree(response);
+		return -EPROTO;
+	}
+	value = response[0] ? -ns3_error(response[0]) : 0;
+	kfree(response);
+	if (get_user(len, optlen))
+		return -EFAULT;
+	len = min_t(int, len, sizeof(value));
+	if (put_user(len, optlen) || copy_to_user(optval, &value, len))
+		return -EFAULT;
+	return 0;
+}
+
+static int ns3_release(struct socket *sock)
+{
+	struct sock *sk = sock->sk;
+	struct ns3_sock *nsk;
+	u8 payload[8], *response = NULL;
+	size_t response_len = 0;
+
+	if (!sk)
+		return 0;
+	nsk = ns3_sk(sock);
+	if (nsk->backend == NS3_REMOTE) {
+		mutex_lock(&ns3_lock);
+		if (!list_empty(&nsk->remote_node))
+			list_del_init(&nsk->remote_node);
+		mutex_unlock(&ns3_lock);
+		put_unaligned_le64(nsk->handle, payload);
+		ns3_call(nsk, NS3_CLOSE, payload, sizeof(payload),
+			 &response, &response_len);
+		kfree(response);
+	} else if (nsk->inner) {
+		sock_release(nsk->inner);
+	}
+	if (refcount_dec_and_test(&nsk->client->refs)) {
+		if (nsk->client->opened) {
+			response = NULL;
+			response_len = 0;
+			ns3_call(nsk, NS3_CLOSE_CLIENT, NULL, 0,
+				 &response, &response_len);
+			kfree(response);
+		}
+		kfree(nsk->client);
+	}
+	sock_orphan(sk);
+	sock->sk = NULL;
+	sock_put(sk);
+	return 0;
+}
+
+#define NS3_OPS(name, fam, accept_fn, listen_fn) \
+static const struct proto_ops name = { \
+	.family = fam, .owner = THIS_MODULE, .release = ns3_release, \
+	.bind = ns3_bind, .connect = ns3_connect, \
+	.socketpair = sock_no_socketpair, .accept = accept_fn, \
+	.getname = ns3_getname, .poll = ns3_poll, .ioctl = sock_no_ioctl, \
+	.listen = listen_fn, .shutdown = ns3_shutdown, \
+	.setsockopt = ns3_setsockopt, .getsockopt = ns3_getsockopt, \
+	.sendmsg = ns3_sendmsg, .recvmsg = ns3_recvmsg, .mmap = sock_no_mmap, \
+}
+
+NS3_OPS(ns3_inet_stream_ops, PF_INET, ns3_accept, ns3_listen);
+NS3_OPS(ns3_inet_dgram_ops, PF_INET, sock_no_accept, sock_no_listen);
+NS3_OPS(ns3_inet6_stream_ops, PF_INET6, ns3_accept, ns3_listen);
+NS3_OPS(ns3_inet6_dgram_ops, PF_INET6, sock_no_accept, sock_no_listen);
+
+static struct proto ns3_proto = {
+	.name = "NETSTACK3",
+	.owner = THIS_MODULE,
+	.obj_size = sizeof(struct ns3_sock),
+};
+
+bool netstack3_provider_supported(int type, int protocol)
+{
+	return (type == SOCK_STREAM && (!protocol || protocol == IPPROTO_TCP)) ||
+	       (type == SOCK_DGRAM && (!protocol || protocol == IPPROTO_UDP));
+}
+
+static int ns3_init_socket(struct net *net, struct socket *sock, int family,
+			   int type, int protocol, u64 client_id,
+			   struct ns3_client *client)
+{
+	struct ns3_sock *nsk;
+	struct sock *sk;
+
+	if (client) {
+		refcount_inc(&client->refs);
+	} else {
+		client = kzalloc(sizeof(*client), GFP_KERNEL);
+		if (!client)
+			return -ENOMEM;
+		refcount_set(&client->refs, 1);
+	}
+	sk = sk_alloc(net, family, GFP_KERNEL, &ns3_proto, false);
+	if (!sk) {
+		if (refcount_dec_and_test(&client->refs))
+			kfree(client);
+		return -ENOMEM;
+	}
+	sock_init_data(sock, sk);
+	nsk = container_of(sk, struct ns3_sock, sk);
+	nsk->family = family;
+	nsk->type = type;
+	nsk->protocol = protocol ?: (type == SOCK_STREAM ? IPPROTO_TCP : IPPROTO_UDP);
+	nsk->namespace_id = net->ns.inum;
+	nsk->client_id = client_id ?: atomic64_inc_return(&ns3_next_client);
+	nsk->client = client;
+	INIT_LIST_HEAD(&nsk->remote_node);
+	sock->ops = family == PF_INET ?
+		(type == SOCK_STREAM ? &ns3_inet_stream_ops : &ns3_inet_dgram_ops) :
+		(type == SOCK_STREAM ? &ns3_inet6_stream_ops : &ns3_inet6_dgram_ops);
+	sk->sk_protocol = nsk->protocol;
+	sk->sk_state = TCP_CLOSE;
+	return 0;
+}
+
+int netstack3_provider_create(struct net *net, struct socket *sock,
+			      int family, int protocol)
+{
+	return ns3_init_socket(net, sock, family, sock->type, protocol, 0, NULL);
+}
+
+static ssize_t ns3_device_read(struct file *file, char __user *buf,
+			       size_t len, loff_t *ppos)
+{
+	struct ns3_request *req;
+	int ret;
+
+	if (file->f_flags & O_NONBLOCK) {
+		mutex_lock(&ns3_lock);
+		if (!ns3_active)
+			ret = -ENODEV;
+		else if (list_empty(&ns3_queue))
+			ret = -EAGAIN;
+		else
+			ret = 0;
+		mutex_unlock(&ns3_lock);
+		if (ret)
+			return ret;
+	} else {
+		ret = wait_event_interruptible(ns3_provider_wait,
+				       !list_empty_careful(&ns3_queue) || !ns3_active);
+		if (ret)
+			return ret;
+	}
+	mutex_lock(&ns3_lock);
+	if (!ns3_active) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (list_empty(&ns3_queue)) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	req = list_first_entry(&ns3_queue, struct ns3_request, queued);
+	if (len < req->frame_len) {
+		ret = -EMSGSIZE;
+		goto out;
+	}
+	if (copy_to_user(buf, req->frame, req->frame_len)) {
+		ret = -EFAULT;
+		goto out;
+	}
+	list_del_init(&req->queued);
+	ns3_queued--;
+	ret = req->frame_len;
+out:
+	mutex_unlock(&ns3_lock);
+	return ret;
+}
+
+static struct ns3_request *ns3_find_request(const struct ns3_header *h)
+{
+	struct ns3_request *req;
+
+	list_for_each_entry(req, &ns3_pending, pending) {
+		const struct ns3_header *wanted = (const void *)req->frame;
+		if (h->request_id == wanted->request_id &&
+		    h->opcode == wanted->opcode &&
+		    h->namespace_id == wanted->namespace_id &&
+		    h->client_id == wanted->client_id)
+			return req;
+	}
+	return NULL;
+}
+
+static int ns3_readiness_event(const struct ns3_header *h, const u8 *payload)
+{
+	struct ns3_sock *nsk;
+	u64 handle;
+
+	if (le16_to_cpu(h->opcode) != NS3_READINESS_CHANGED ||
+	    le32_to_cpu(h->payload_len) != 19)
+		return -EPROTO;
+	handle = get_unaligned_le64(payload + 8);
+	list_for_each_entry(nsk, &ns3_sockets, remote_node) {
+		if (nsk->provider_generation != ns3_generation || nsk->handle != handle ||
+		    cpu_to_le64(nsk->namespace_id) != h->namespace_id ||
+		    cpu_to_le64(nsk->client_id) != h->client_id)
+			continue;
+		nsk->readiness_sequence = get_unaligned_le64(payload);
+		nsk->provider_readiness = get_unaligned_le16(payload + 16);
+		if (nsk->provider_readiness & 0xc0)
+			WRITE_ONCE(nsk->connecting, false);
+		nsk->readiness = (get_unaligned_le16(payload + 16) & 0x0d ? EPOLLIN | EPOLLRDNORM : 0) |
+			(get_unaligned_le16(payload + 16) & 0x02 ? EPOLLOUT | EPOLLWRNORM : 0) |
+			(get_unaligned_le16(payload + 16) & 0xa0 ? EPOLLERR : 0) |
+			(get_unaligned_le16(payload + 16) & 0x18 ? EPOLLHUP : 0);
+		wake_up_interruptible_poll(sk_sleep(&nsk->sk),
+					   nsk->readiness | EPOLLERR | EPOLLHUP);
+		return 0;
+	}
+	/* A close can race an already queued readiness notification. */
+	return 0;
+}
+
+static ssize_t ns3_device_write(struct file *file, const char __user *buf,
+				size_t len, loff_t *ppos)
+{
+	struct ns3_header *h;
+	struct ns3_request *req;
+	u8 *frame;
+	int ret = len;
+
+	if (len < NS3_HEADER_LEN || len > NS3_HEADER_LEN + NS3_MAX_PAYLOAD)
+		return -EMSGSIZE;
+	frame = memdup_user(buf, len);
+	if (IS_ERR(frame))
+		return PTR_ERR(frame);
+	h = (struct ns3_header *)frame;
+	if (!ns3_header_valid(h, len)) {
+		ret = -EPROTO;
+		goto free;
+	}
+	mutex_lock(&ns3_lock);
+	if (!ns3_active) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	if (le16_to_cpu(h->type) == NS3_READINESS_EVENT) {
+		ret = ns3_readiness_event(h, frame + NS3_HEADER_LEN) ?: len;
+		goto unlock;
+	}
+	if (le16_to_cpu(h->type) != NS3_RESPONSE) {
+		ret = -EPROTO;
+		goto unlock;
+	}
+	req = ns3_find_request(h);
+	if (!req) {
+		ret = -ENOENT;
+		goto unlock;
+	}
+	req->response_len = le32_to_cpu(h->payload_len);
+	req->response = kmemdup(frame + NS3_HEADER_LEN, req->response_len,
+				GFP_KERNEL);
+	if (!req->response && req->response_len) {
+		ret = -ENOMEM;
+		goto unlock;
+	}
+	list_del_init(&req->pending);
+	complete(&req->done);
+unlock:
+	mutex_unlock(&ns3_lock);
+free:
+	kfree(frame);
+	return ret;
+}
+
+static __poll_t ns3_device_poll(struct file *file, poll_table *wait)
+{
+	__poll_t mask = EPOLLOUT | EPOLLWRNORM;
+
+	poll_wait(file, &ns3_provider_wait, wait);
+	mutex_lock(&ns3_lock);
+	if (!ns3_active)
+		mask = EPOLLERR | EPOLLHUP;
+	else if (!list_empty(&ns3_queue))
+		mask |= EPOLLIN | EPOLLRDNORM;
+	mutex_unlock(&ns3_lock);
+	return mask;
+}
+
+static int ns3_device_open(struct inode *inode, struct file *file)
+{
+	int ret = 0;
+
+	mutex_lock(&ns3_lock);
+	if (ns3_active)
+		ret = -EBUSY;
+	else {
+		ns3_generation++;
+		ns3_active = true;
+	}
+	mutex_unlock(&ns3_lock);
+	return ret;
+}
+
+static int ns3_device_release(struct inode *inode, struct file *file)
+{
+	struct ns3_request *req;
+	struct ns3_sock *nsk;
+
+	mutex_lock(&ns3_lock);
+	ns3_active = false;
+	list_for_each_entry(req, &ns3_pending, pending) {
+		req->error = -ENETDOWN;
+		complete(&req->done);
+	}
+	list_for_each_entry(nsk, &ns3_sockets, remote_node)
+		wake_up_interruptible_poll(sk_sleep(&nsk->sk), EPOLLERR | EPOLLHUP);
+	mutex_unlock(&ns3_lock);
+	wake_up_interruptible(&ns3_provider_wait);
+	return 0;
+}
+
+static const struct file_operations ns3_device_fops = {
+	.owner = THIS_MODULE, .open = ns3_device_open, .release = ns3_device_release,
+	.read = ns3_device_read, .write = ns3_device_write,
+	.poll = ns3_device_poll,
+};
+
+static struct miscdevice ns3_device = {
+	.minor = MISC_DYNAMIC_MINOR, .name = "netstack3-provider",
+	.fops = &ns3_device_fops, .mode = 0600,
+};
+
+static int __init ns3_init(void)
+{
+	int ret = proto_register(&ns3_proto, 1);
+
+	if (ret)
+		return ret;
+	ret = misc_register(&ns3_device);
+	if (ret)
+		proto_unregister(&ns3_proto);
+	return ret;
+}
+subsys_initcall(ns3_init);
