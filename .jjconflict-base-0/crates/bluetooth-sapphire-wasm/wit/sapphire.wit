package drv:bluetooth-sapphire@0.1.0;

/// The only controller authority visible to Sapphire. The embedding Rust host
/// copies every list across the WASM boundary and enforces packet and queue
/// bounds before performing native I/O.
interface controller {
  enum outbound-kind {
    command,
    acl,
    sco,
    iso,
  }

  enum transport-error {
    closed,
    invalid-packet,
    quota-exceeded,
  }

  record sco-configuration {
    coding-format: u8,
    encoding: u8,
    sample-rate: u8,
  }

  send: func(kind: outbound-kind, packet: list<u8>) -> result<_, transport-error>;
  controller-features: func() -> u32;
  configure-sco: func(configuration: sco-configuration) -> result<_, transport-error>;
  reset-sco: func() -> result<_, transport-error>;
}

/// Project-specific runtime facilities. Standard clocks, timers, polling, and
/// secure randomness use the explicitly linked WASI interfaces in the world.
interface runtime {
  enum log-level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  log: func(level: log-level, message: string);
  metric: func(id: u32, value: s64);
}

/// Persistence is identity-keyed by the native policy layer. Sapphire never
/// receives a path, descriptor, database connection, or enumeration ability.
interface bond-store {
  load: func(identity: list<u8>) -> result<option<list<u8>>>;
  store: func(identity: list<u8>, value: list<u8>) -> result;
  remove: func(identity: list<u8>) -> result;
}

/// Serialized entry points into the single Sapphire instance. `packet` is an
/// HCI event or ACL/SCO/ISO payload without a native pointer or descriptor.
interface host {
  enum inbound-kind {
    event,
    acl,
    sco,
    iso,
  }

  initialize: func() -> result;
  inject-controller-packet: func(kind: inbound-kind, packet: list<u8>) -> result;
  shutdown: func();
}

world sapphire {
  import wasi:clocks/monotonic-clock@0.2.12;
  import wasi:io/poll@0.2.12;
  import wasi:random/random@0.2.12;
  import controller;
  import runtime;
  import bond-store;
  export host;
}
